<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>薪轉管理 · 米胡電競 MiHu Gaming</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --bg-color: #0b0914;
            --sidebar-bg: #131021;
            --card-bg: rgba(23, 19, 38, 0.85);
            --card-border: rgba(168, 85, 247, 0.2);
            --text-light: #f3f4f6;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            background-color: var(--bg-color);
            color: var(--text-light);
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            display: flex;
            min-height: 100vh;
            overflow-x: hidden;
        }

        .main-wrapper {
            flex-grow: 1;
            display: flex;
            flex-direction: column;
            overflow-y: auto;
            max-height: 100vh;
            width: calc(100vw - 280px);
            min-width: 0;
        }

        .content-body { 
            padding: 24px 36px 32px; 
            flex-grow: 1; 
        }

        .search-box-wrap { position: relative; width: 260px; flex-shrink: 0; }
        .search-input-glass {
            background-color: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.14);
            color: #ffffff !important;
            border-radius: 30px;
            padding: 8px 36px 8px 38px;
            font-size: 0.88rem;
            width: 100%;
        }
        .search-input-glass::placeholder { color: #94a3b8 !important; }
        .search-icon-left {
            position: absolute; left: 14px; top: 50%;
            transform: translateY(-50%); color: #94a3b8; font-size: 0.88rem;
        }
        .search-clear-btn {
            position: absolute; right: 12px; top: 50%;
            transform: translateY(-50%); color: #94a3b8; display: none; border: none; background: transparent;
        }

        /* 🚀 專屬 Excel 匯出按鈕樣式 */
        .btn-excel-export {
            background: linear-gradient(135deg, #10b981 0%, #059669 100%);
            color: #ffffff;
            font-weight: 700;
            font-size: 0.88rem;
            border-radius: 30px;
            padding: 8px 20px;
            border: 1px solid rgba(16, 185, 129, 0.4);
            box-shadow: 0 4px 14px rgba(16, 185, 129, 0.3);
            transition: all 0.25s ease;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }
        .btn-excel-export:hover {
            background: linear-gradient(135deg, #059669 0%, #047857 100%);
            color: #ffffff;
            box-shadow: 0 6px 20px rgba(16, 185, 129, 0.45);
            transform: translateY(-1px);
        }
    </style>
</head>
<body>

<%- include('partials/sidebar', { activePage: 'payroll' }) %>

<div class="main-wrapper">
    <%- include('partials/navbar', { activePage: 'payroll' }) %>

    <div class="content-body">
        <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
            <div>
                <div class="page-title-text" style="font-size: 1.5rem; font-weight: 800; color: #ffffff; display: flex; align-items: center; gap: 10px; margin-bottom: 4px;">
                    <i class="fa-solid fa-money-check-dollar text-warning"></i>
                    <span>薪轉管理</span>
                </div>
                <p class="text-secondary small mb-0">工作室員工與陪陪個人隱私薪轉個資清算與累積發放薪資總額核算</p>
            </div>

            <div class="d-flex align-items-center gap-3">
                <!-- 🚀 Excel 匯出按鈕 -->
                <a href="/management/payroll/export" class="btn-excel-export" title="匯出完整薪轉 Excel 表格">
                    <i class="fa-solid fa-file-excel"></i>
                    <span>匯出薪轉 Excel</span>
                </a>

                <div class="search-box-wrap">
                    <i class="fa-solid fa-magnifying-glass search-icon-left"></i>
                    <input type="text" id="payrollSearchInput" class="search-input-glass" placeholder="搜尋暱稱 / 本名 / 銀行 / 帳號...">
                    <button type="button" id="clearPayrollSearchBtn" class="search-clear-btn" title="清除搜尋"><i class="fa-solid fa-circle-xmark"></i></button>
                </div>
            </div>
        </div>

        <% if (typeof successMsg !== 'undefined' && successMsg) { %>
            <div class="alert alert-success py-2 px-3 small mb-4 border-0 bg-success bg-opacity-25 text-success">
                ✅ <%= successMsg %>
            </div>
        <% } %>

        <!-- 📊 3. 7 列自訂滾動表格清單組件 -->
        <%- include('partials/payroll_table', { staffList: typeof staffList !== 'undefined' ? staffList : [] }) %>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', () => {
        const searchInput = document.getElementById('payrollSearchInput');
        const clearBtn = document.getElementById('clearPayrollSearchBtn');
        const rows = document.querySelectorAll('.payroll-row');
        const noMatchRow = document.getElementById('noPayrollMatchRow');

        if (searchInput) {
            searchInput.addEventListener('input', () => {
                const query = searchInput.value.trim().toLowerCase();
                let visibleCount = 0;

                if (clearBtn) clearBtn.style.display = query.length > 0 ? 'block' : 'none';

                rows.forEach(row => {
                    const searchData = row.getAttribute('data-search') || '';
                    if (searchData.includes(query)) {
                        row.style.display = '';
                        visibleCount++;
                    } else {
                        row.style.display = 'none';
                    }
                });

                if (noMatchRow) noMatchRow.style.display = visibleCount === 0 ? 'block' : 'none';
            });

            if (clearBtn) {
                clearBtn.addEventListener('click', () => {
                    searchInput.value = '';
                    clearBtn.style.display = 'none';
                    rows.forEach(row => row.style.display = '');
                    if (noMatchRow) noMatchRow.style.display = 'none';
                    searchInput.focus();
                });
            }
        }
    });
</script>
<%- include('partials/feature_modal') %>
</body>
</html>