<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>首頁 · 米胡電競 MiHu Gaming</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --bg-color: #0b0914;
            --sidebar-bg: #131021;
            --card-bg: rgba(23, 19, 38, 0.75);
            --card-border: rgba(168, 85, 247, 0.15);
            --mihu-purple: #9333ea;
            --mihu-purple-light: #c084fc;
            --mihu-yellow: #fde047;
            --text-light: #f3f4f6;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            background-color: var(--bg-color);
            color: var(--text-light);
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            display: flex;
            min-height: 100vh;
        }

        .main-wrapper {
            flex-grow: 1;
            display: flex;
            flex-direction: column;
            overflow-y: auto;
            max-height: 100vh;
        }

        .content-body { padding: 32px; flex-grow: 1; }

        /* 🚀 質感化即時公告欄樣式 */
        .notice-banner {
            background: linear-gradient(90deg, rgba(168, 85, 247, 0.12), rgba(236, 72, 153, 0.08));
            border: 1px solid rgba(168, 85, 247, 0.3);
            border-radius: 16px;
            padding: 12px 20px;
            display: flex;
            align-items: center;
            gap: 14px;
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3), inset 0 1px 0 rgba(255, 255, 255, 0.08);
            backdrop-filter: blur(14px);
            margin-bottom: 24px;
            overflow: hidden;
        }
        .notice-badge-glow {
            background: linear-gradient(135deg, rgba(147, 51, 234, 0.35), rgba(192, 132, 252, 0.25));
            border: 1px solid rgba(192, 132, 252, 0.5);
            color: #e9d5ff;
            font-size: 0.82rem;
            font-weight: 700;
            padding: 5px 14px;
            border-radius: 20px;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            flex-shrink: 0;
            box-shadow: 0 0 12px rgba(168, 85, 247, 0.35);
        }
        .notice-content-wrap {
            display: flex;
            align-items: center;
            gap: 10px;
            overflow: hidden;
            flex-grow: 1;
        }
        .notice-content {
            color: #f8fafc;
            font-size: 0.93rem;
            font-weight: 500;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .glass-card {
            background: var(--card-bg);
            border: 1px solid var(--card-border);
            border-radius: 20px;
            padding: 28px;
            backdrop-filter: blur(15px);
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
            height: 100%;
        }

        .wallet-card-container {
            position: relative;
            width: 100%;
            max-width: 440px;
            min-height: 240px;
            border-radius: 22px;
            padding: 24px 26px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            overflow: hidden;
            box-shadow: 0 16px 36px rgba(0, 0, 0, 0.5);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }
        .wallet-card-container:hover {
            transform: translateY(-4px);
            box-shadow: 0 22px 45px rgba(0, 0, 0, 0.65);
        }

        .vip-theme-0 {
            background: linear-gradient(135deg, #1e1b29 0%, #110e1a 100%);
            border: 1px solid rgba(255, 255, 255, 0.12);
        }
        .vip-theme-1, .vip-theme-2 {
            background: linear-gradient(135deg, #3b0764 0%, #1e1136 60%, #100b1e 100%);
            border: 1px solid rgba(168, 85, 247, 0.4);
            box-shadow: 0 16px 36px rgba(147, 51, 234, 0.25);
        }
        .vip-theme-3, .vip-theme-4 {
            background: linear-gradient(135deg, #064e3b 0%, #0f172a 50%, #1e1b4b 100%);
            border: 1px solid rgba(56, 189, 248, 0.45);
            box-shadow: 0 16px 36px rgba(56, 189, 248, 0.2);
        }
        .vip-theme-5, .vip-theme-6 {
            background: linear-gradient(135deg, #78350f 0%, #311804 50%, #190c02 100%);
            border: 1px solid rgba(250, 204, 21, 0.45);
            box-shadow: 0 16px 36px rgba(234, 179, 8, 0.25);
        }
        .vip-theme-7 {
            background: radial-gradient(circle at 10% 20%, #2e1065 0%, #0d0914 80%),
                        linear-gradient(135deg, #4c1d95 0%, #000000 100%);
            border: 1px solid rgba(253, 224, 71, 0.6);
            box-shadow: 0 18px 45px rgba(253, 224, 71, 0.25);
        }

        .card-chip {
            width: 44px;
            height: 32px;
            background: linear-gradient(135deg, #fbbf24 0%, #d97706 100%);
            border-radius: 6px;
            position: relative;
            box-shadow: inset 0 1px 2px rgba(255, 255, 255, 0.4), 0 2px 4px rgba(0,0,0,0.4);
        }
        .card-chip::after {
            content: '';
            position: absolute;
            top: 50%;
            left: 0;
            width: 100%;
            height: 1px;
            background: rgba(0, 0, 0, 0.35);
        }

        .card-watermark {
            position: absolute;
            right: -25px;
            bottom: -25px;
            width: 180px;
            height: auto;
            opacity: 0.08;
            pointer-events: none;
            filter: grayscale(100%);
        }

        .card-balance-num {
            font-size: 1.95rem;
            font-weight: 800;
            letter-spacing: 0.5px;
            color: #ffffff;
            text-shadow: 0 2px 10px rgba(0, 0, 0, 0.5);
            line-height: 1;
        }

        .card-vip-badge {
            background: rgba(255, 255, 255, 0.12);
            border: 1px solid rgba(255, 255, 255, 0.2);
            padding: 5px 14px;
            border-radius: 30px;
            font-weight: 800;
            font-size: 0.88rem;
            backdrop-filter: blur(8px);
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

        .info-list-group {
            display: flex;
            flex-direction: column;
            gap: 12px;
            margin-top: 20px;
        }
        .info-list-row {
            background: rgba(255, 255, 255, 0.02);
            border: 1px solid rgba(255, 255, 255, 0.06);
            border-radius: 14px;
            padding: 14px 20px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            transition: all 0.2s ease;
        }
        .info-list-row:hover {
            background: rgba(168, 85, 247, 0.06);
            border-color: rgba(168, 85, 247, 0.28);
            transform: translateX(4px);
        }
        .info-row-left {
            display: flex;
            align-items: center;
            gap: 12px;
        }
        .info-row-icon {
            width: 34px;
            height: 34px;
            border-radius: 10px;
            background: rgba(255, 255, 255, 0.04);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.95rem;
            flex-shrink: 0;
        }
        .info-row-label {
            font-size: 0.85rem;
            color: #94a3b8;
            font-weight: 600;
            letter-spacing: 0.3px;
        }
        .info-row-value {
            font-size: 0.96rem;
            font-weight: 700;
            color: #ffffff;
            text-align: right;
            word-break: break-all;
        }

        .role-badge-pill {
            display: inline-flex;
            align-items: center;
            padding: 5px 16px;
            border-radius: 20px;
            font-size: 0.8rem;
            font-weight: 700;
            letter-spacing: 0.5px;
        }
    </style>
</head>
<body>

<%- include('partials/sidebar', { activePage: 'dashboard' }) %>

<%
    const perms = (typeof userPerms !== 'undefined' && userPerms) ? userPerms : [];
    const isSuperAdmin = (typeof currentUser !== 'undefined' && currentUser && (currentUser.id === '604610298581876746' || currentUser.role === 'admin'));
    const hasPerm = (node) => isSuperAdmin || perms.includes(node);

    // 🚀 動態職位對照表 (對齊角色與權限設定)
    const roleMap = {
        'admin': { name: '負責人', class: 'bg-danger text-white' },
        'manager': { name: '店長', class: 'bg-warning text-dark' },
        'cfo': { name: '財務長', class: 'bg-danger text-white' },
        'aftersales': { name: '售後管理', class: 'bg-warning text-dark' },
        'after_sales': { name: '售後管理', class: 'bg-warning text-dark' },
        'cs_director': { name: '客服主管', class: 'bg-warning text-dark' },
        'cs': { name: '客服', class: 'bg-info text-dark' },
        'staff': { name: '陪陪', class: 'bg-primary text-white' },
        'talent': { name: '陪陪', class: 'bg-primary text-white' },
        'member': { name: '一般會員', class: 'bg-secondary text-white' }
    };
    
    const userRoleKey = user.role || 'member';
    const roleObj = roleMap[userRoleKey] || { name: '在職員工', class: 'bg-primary text-white' };
%>

<div class="main-wrapper">
    <%- include('partials/navbar', { activePage: 'dashboard' }) %>

    <div class="content-body">
        <!-- 1. 質感即時通知公告欄 -->
        <% if (hasPerm('home_banner')) { %>
            <div class="notice-banner">
                <% if (typeof announcement !== 'undefined' && announcement) { 
                    const rawTitle = announcement.title || '';
                    const tagMatch = rawTitle.match(/\[(.*?)\]/);
                    const tagText = tagMatch ? tagMatch[1] : '即時通知';
                    const cleanTitle = rawTitle.replace(/\[.*?\]/, '').trim();
                    const fullContent = (cleanTitle ? cleanTitle + ' ' : '') + (announcement.content || '');
                %>
                    <div class="notice-badge-glow">
                        <i class="fa-solid fa-bullhorn text-warning"></i>
                        <span><%= tagText %></span>
                    </div>
                    <div class="notice-content-wrap">
                        <span class="notice-content"><%= fullContent %></span>
                    </div>
                    <span class="ms-auto text-secondary micro font-monospace flex-shrink-0">
                        <%= new Date(announcement.created_at || Date.now()).toLocaleDateString() %>
                    </span>
                <% } else { %>
                    <div class="notice-badge-glow">
                        <i class="fa-solid fa-bullhorn text-warning"></i>
                        <span>即時通知</span>
                    </div>
                    <div class="notice-content-wrap">
                        <span class="notice-content text-secondary">暫無最新公告訊息</span>
                    </div>
                <% } %>
            </div>
        <% } %>

        <div class="row g-4">
            <!-- 2. 我的錢包 (VIP 卡片 - 若有 home_wallet_card 權限才顯示) -->
            <% if (hasPerm('home_wallet_card')) { 
                const userVip = Number(user.vip_level || 0);
                const themeClass = userVip >= 7 ? 'vip-theme-7' : `vip-theme-${userVip}`;
                const totalBalance = (Number(user.balance || 0) + Number(user.bonus_balance || 0)).toLocaleString();
                const colSize = hasPerm('home_info') ? 'col-xl-5 col-lg-6 col-12' : 'col-12';
            %>
                <div class="<%= colSize %>">
                    <div class="glass-card d-flex flex-column justify-content-between">
                        <div>
                            <h4 class="fw-bold mb-1 text-white">
                                <i class="fa-solid fa-wallet me-2" style="color: var(--mihu-purple-light);"></i>我的錢包
                            </h4>
                            <p style="color: #94a3b8;" class="small mb-3">個人儲值餘額與尊榮 VIP 身分卡</p>
                        </div>

                        <div class="d-flex justify-content-center">
                            <div class="wallet-card-container <%= themeClass %>">
                                <img src="/images/logo2.png" alt="MIHU" class="card-watermark" onerror="this.style.display='none'">

                                <div class="d-flex justify-content-between align-items-center">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="card-chip"></div>
                                        <i class="fa-solid fa-wifi text-secondary fa-rotate-90 opacity-75"></i>
                                    </div>
                                    <div class="card-vip-badge">
                                        <i class="fa-solid fa-crown text-warning"></i>
                                        <span><%= userVip > 0 ? `VIP ${userVip}` : '一般會員' %></span>
                                    </div>
                                </div>

                                <div class="my-3">
                                    <span class="small text-white-50 text-uppercase fw-semibold" style="letter-spacing: 1px; font-size: 0.72rem;">Total Balance</span>
                                    <div class="d-flex align-items-baseline gap-2 mt-1">
                                        <span class="card-balance-num font-monospace">$<%= totalBalance %></span>
                                        <span class="text-white-50 fw-bold small">NTD</span>
                                    </div>
                                </div>

                                <div class="d-flex justify-content-between align-items-end pt-2 border-top border-white border-opacity-10">
                                    <div>
                                        <div class="text-white-50" style="font-size: 0.68rem; text-transform: uppercase;">Card Holder</div>
                                        <div class="text-white fw-bold small"><%= user.custom_nickname || user.global_name || user.username %></div>
                                    </div>
                                    <div class="text-end">
                                        <div class="text-white-50" style="font-size: 0.68rem; text-transform: uppercase;">Member ID</div>
                                        <div class="font-monospace text-white small opacity-75">•••• <%= user.id.slice(-4) %></div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-around mt-4 pt-3 border-top border-secondary border-opacity-25 text-center">
                            <div>
                                <div class="text-secondary small">實充餘額</div>
                                <div class="fw-bold text-white font-monospace mt-1">$<%= Number(user.balance || 0).toLocaleString() %></div>
                            </div>
                            <div class="border-end border-secondary border-opacity-25"></div>
                            <div>
                                <div class="text-secondary small">贈送餘額</div>
                                <div class="fw-bold text-warning font-monospace mt-1">$<%= Number(user.bonus_balance || 0).toLocaleString() %></div>
                            </div>
                        </div>
                    </div>
                </div>
            <% } %>

            <!-- 3. 我的信息 (若有 home_info 權限才顯示) -->
            <% if (hasPerm('home_info')) { 
                const colSize = hasPerm('home_wallet_card') ? 'col-xl-7 col-lg-6 col-12' : 'col-12';
            %>
                <div class="<%= colSize %>">
                    <div class="glass-card">
                        <div>
                            <h4 class="fw-bold mb-1 text-white">
                                <i class="fa-solid fa-address-card me-2 text-warning"></i>我的信息
                            </h4>
                            <p style="color: #94a3b8;" class="small mb-0">個人帳號身分與 Discord 連動認證狀態</p>
                        </div>

                        <div class="info-list-group">
                            <div class="info-list-row">
                                <div class="info-row-left">
                                    <div class="info-row-icon" style="color: #5865f2;">
                                        <i class="fa-brands fa-discord"></i>
                                    </div>
                                    <span class="info-row-label">Discord ID</span>
                                </div>
                                <div class="info-row-value font-monospace text-light"><%= user.id %></div>
                            </div>

                            <div class="info-list-row">
                                <div class="info-row-left">
                                    <div class="info-row-icon" style="color: #38bdf8;">
                                        <i class="fa-solid fa-at"></i>
                                    </div>
                                    <span class="info-row-label">Discord 使用者名稱</span>
                                </div>
                                <div class="info-row-value"><%= user.username %></div>
                            </div>

                            <div class="info-list-row">
                                <div class="info-row-left">
                                    <div class="info-row-icon" style="color: #fbbf24;">
                                        <i class="fa-solid fa-signature"></i>
                                    </div>
                                    <span class="info-row-label">自定義暱稱</span>
                                </div>
                                <div class="info-row-value text-warning">
                                    <%= user.custom_nickname ? user.custom_nickname : (user.global_name || '尚未設定') %>
                                </div>
                            </div>

                            <!-- 🚀 身分標籤：完全同步動態職位 -->
                            <div class="info-list-row">
                                <div class="info-row-left">
                                    <div class="info-row-icon" style="color: #34d399;">
                                        <i class="fa-solid fa-shield-halved"></i>
                                    </div>
                                    <span class="info-row-label">工作室身分</span>
                                </div>
                                <div class="info-row-value">
                                    <span class="badge role-badge-pill <%= roleObj.class %>">
                                        <%= roleObj.name %>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            <% } %>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<%- include('partials/feature_modal') %>
</body>
</html>