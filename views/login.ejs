<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>米胡電競 MiHu Gaming · 後台管理系統</title>
    <!-- Bootstrap 5 & FontAwesome -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --mihu-purple: #9333ea;
            --mihu-purple-light: #c084fc;
            --mihu-pink: #ec4899;
            --mihu-yellow: #fde047;
            --mihu-bg: #090710;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            background-color: var(--mihu-bg);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            color: #f8f9fa;
            position: relative;
            overflow-x: hidden;
        }

        /* 1. 電競數位空間網格與星點背景 */
        .cyber-grid {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            background-image: 
                linear-gradient(to right, rgba(168, 85, 247, 0.04) 1px, transparent 1px),
                linear-gradient(to bottom, rgba(168, 85, 247, 0.04) 1px, transparent 1px);
            background-size: 50px 50px;
            mask-image: radial-gradient(circle at 50% 50%, black 30%, transparent 80%);
            -webkit-mask-image: radial-gradient(circle at 50% 50%, black 30%, transparent 80%);
            pointer-events: none;
            z-index: 0;
        }

        /* 2. 動態極光背景光暈 */
        .ambient-glow {
            position: fixed;
            width: 600px;
            height: 600px;
            border-radius: 50%;
            filter: blur(140px);
            opacity: 0.35;
            pointer-events: none;
            z-index: 0;
        }
        .glow-1 {
            background: radial-gradient(circle, #7e22ce, transparent 70%);
            top: -150px;
            left: 50%;
            transform: translateX(-50%);
            animation: pulse-glow 8s ease-in-out infinite alternate;
        }
        .glow-2 {
            background: radial-gradient(circle, #db2777, transparent 70%);
            bottom: -150px;
            left: 15%;
            animation: float-glow 12s ease-in-out infinite alternate;
        }
        .glow-3 {
            background: radial-gradient(circle, #6366f1, transparent 70%);
            top: 30%;
            right: -100px;
            width: 450px;
            height: 450px;
            opacity: 0.22;
        }

        @keyframes pulse-glow {
            0% { opacity: 0.25; transform: translateX(-50%) scale(0.9); }
            100% { opacity: 0.45; transform: translateX(-50%) scale(1.15); }
        }
        @keyframes float-glow {
            0% { transform: translateY(0px); }
            100% { transform: translateY(-40px); }
        }

        /* 3. 漂浮裝飾星芒 */
        .floating-star {
            position: absolute;
            color: rgba(253, 224, 71, 0.4);
            font-size: 1.2rem;
            pointer-events: none;
            z-index: 1;
            animation: star-float 6s ease-in-out infinite alternate;
        }
        .star-1 { top: 18%; left: 14%; animation-delay: 0s; font-size: 1.4rem; color: rgba(192, 132, 252, 0.5); }
        .star-2 { top: 28%; right: 16%; animation-delay: 2s; color: rgba(244, 114, 182, 0.4); }
        .star-3 { bottom: 22%; left: 18%; animation-delay: 1.5s; }
        .star-4 { bottom: 25%; right: 15%; animation-delay: 3s; font-size: 1.6rem; color: rgba(168, 85, 247, 0.45); }

        @keyframes star-float {
            0% { transform: translateY(0) rotate(0deg) scale(0.85); opacity: 0.3; }
            100% { transform: translateY(-16px) rotate(45deg) scale(1.15); opacity: 0.8; }
        }

        /* 頂部輕量導覽條 */
        .top-nav {
            position: relative;
            z-index: 2;
            padding: 24px 36px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
        .nav-brand {
            font-size: 1.15rem;
            font-weight: 700;
            color: #ffffff;
            display: flex;
            align-items: center;
            gap: 10px;
            letter-spacing: 0.5px;
        }
        .status-badge {
            background: rgba(34, 197, 94, 0.12);
            border: 1px solid rgba(34, 197, 94, 0.3);
            color: #4ade80;
            padding: 5px 14px;
            border-radius: 20px;
            font-size: 0.78rem;
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            gap: 7px;
            backdrop-filter: blur(8px);
        }
        .status-dot {
            width: 7px;
            height: 7px;
            background-color: #22c55e;
            border-radius: 50%;
            box-shadow: 0 0 8px #22c55e;
            animation: pulse-dot 1.8s infinite;
        }
        @keyframes pulse-dot {
            0%, 100% { opacity: 1; transform: scale(1); }
            50% { opacity: 0.4; transform: scale(0.8); }
        }

        /* 主登入區塊容器 */
        .main-wrapper {
            position: relative;
            z-index: 2;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 20px;
            flex-grow: 1;
        }

        .login-container {
            width: 100%;
            max-width: 440px;
            text-align: center;
        }

        /* 吉祥物 LOGO 放大與浮動動態 */
        .logo-wrap {
            margin-bottom: 24px;
            display: inline-block;
            animation: logo-float 4.5s ease-in-out infinite;
        }
        .logo-img {
            width: 220px; /* LOGO 放大為 220px */
            height: auto;
            filter: drop-shadow(0 14px 36px rgba(168, 85, 247, 0.5));
            transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
        }
        .logo-img:hover {
            transform: scale(1.05);
            filter: drop-shadow(0 18px 48px rgba(236, 72, 153, 0.7));
        }

        @keyframes logo-float {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-8px); }
        }

        /* 磨砂玻璃主卡片 */
        .login-card {
            background: rgba(22, 18, 36, 0.75);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-top: 1px solid rgba(255, 255, 255, 0.16);
            border-radius: 28px;
            padding: 40px 34px 34px;
            box-shadow: 0 30px 60px -12px rgba(0, 0, 0, 0.8), 
                        0 0 0 1px rgba(168, 85, 247, 0.12),
                        inset 0 1px 1px rgba(255, 255, 255, 0.1);
            position: relative;
            overflow: hidden;
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
        }

        /* 頂部動態流光 */
        .login-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 3px;
            background: linear-gradient(90deg, #9333ea, #f472b6, #fde047, #9333ea);
            background-size: 300% 100%;
            animation: gradient-move 4s linear infinite;
        }

        @keyframes gradient-move {
            0% { background-position: 0% 50%; }
            100% { background-position: 100% 50%; }
        }

        .welcome-title {
            font-size: 1.6rem;
            font-weight: 800;
            letter-spacing: 0.8px;
            color: #ffffff;
            margin-bottom: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
        }
        .sparkle-icon {
            font-size: 1.15rem;
            color: #facc15;
            filter: drop-shadow(0 0 8px rgba(250, 204, 21, 0.6));
        }

        .welcome-subtitle {
            color: rgba(216, 180, 254, 0.85);
            font-size: 0.98rem;
            font-weight: 500;
            letter-spacing: 0.5px;
            margin-bottom: 32px;
        }

        /* Discord 登入按鈕 + 光掠動態 */
        .btn-discord {
            background: linear-gradient(135deg, #5865F2 0%, #4752C4 100%);
            color: #ffffff;
            border: 1px solid rgba(255, 255, 255, 0.15);
            padding: 13px 26px;
            font-size: 0.96rem;
            font-weight: 600;
            border-radius: 14px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            text-decoration: none;
            transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
            box-shadow: 0 8px 24px -4px rgba(88, 101, 242, 0.5),
                        inset 0 1px 1px rgba(255, 255, 255, 0.25);
            width: 100%;
            max-width: 320px;
            margin: 0 auto;
            position: relative;
            overflow: hidden;
        }

        .btn-discord::after {
            content: '';
            position: absolute;
            top: -50%;
            left: -60%;
            width: 40%;
            height: 200%;
            background: linear-gradient(to right, rgba(255, 255, 255, 0) 0%, rgba(255, 255, 255, 0.25) 50%, rgba(255, 255, 255, 0) 100%);
            transform: rotate(25deg);
            transition: all 0.6s ease;
        }

        .btn-discord:hover {
            color: #ffffff;
            transform: translateY(-2px);
            box-shadow: 0 14px 30px -4px rgba(88, 101, 242, 0.7),
                        inset 0 1px 1px rgba(255, 255, 255, 0.35);
        }

        .btn-discord:hover::after {
            left: 120%;
        }

        /* 4. 特徵徽章列：專業、可愛、成就 */
        .features-bar {
            display: flex;
            gap: 14px;
            justify-content: center;
            margin-top: 26px;
            flex-wrap: wrap;
        }
        .feature-badge {
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 255, 255, 0.07);
            border-radius: 12px;
            padding: 8px 18px;
            font-size: 0.85rem;
            font-weight: 500;
            color: #d1d5db;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            backdrop-filter: blur(6px);
            transition: all 0.25s ease;
        }
        .feature-badge i {
            color: var(--mihu-purple-light);
        }
        .feature-badge:hover {
            background: rgba(255, 255, 255, 0.07);
            border-color: rgba(168, 85, 247, 0.35);
            color: #ffffff;
            transform: translateY(-2px);
        }

        /* 頁尾署名 */
        .bottom-footer {
            position: relative;
            z-index: 2;
            padding: 20px;
            text-align: center;
            font-size: 0.76rem;
            color: #6b6387;
            font-weight: 500;
            letter-spacing: 0.8px;
        }

        .alert-mihu {
            background: rgba(239, 68, 68, 0.12);
            border: 1px solid rgba(239, 68, 68, 0.35);
            color: #fca5a5;
            border-radius: 12px;
            font-size: 0.88rem;
            backdrop-filter: blur(5px);
        }
    </style>
</head>
<body>

<!-- 數位網格背景 -->
<div class="cyber-grid"></div>

<!-- 極光氛圍光斑 -->
<div class="ambient-glow glow-1"></div>
<div class="ambient-glow glow-2"></div>
<div class="ambient-glow glow-3"></div>

<!-- 四周浮動星芒點綴 -->
<div class="floating-star star-1">✦</div>
<div class="floating-star star-2">✦</div>
<div class="floating-star star-3">✦</div>
<div class="floating-star star-4">✦</div>

<!-- 頂部資訊列：MiHu Gaming -->
<header class="top-nav">
    <div class="nav-brand">
        <i class="fa-solid fa-gamepad" style="color: var(--mihu-purple-light);"></i>
        <span>MiHu Gaming</span>
    </div>
    <div class="status-badge">
        <span class="status-dot"></span>
        <span>系統連線正常 · 2026</span>
    </div>
</header>

<!-- 主視覺核心 -->
<main class="main-wrapper">
    <div class="login-container">
        <!-- 吉祥物品牌圖像 (放大至 220px) -->
        <div class="logo-wrap">
            <img src="/images/logo.png" alt="米胡電競 MiHu Gaming" class="logo-img" onerror="this.style.display='none'">
        </div>

        <!-- 質感磨砂玻璃卡片 -->
        <div class="login-card">
            <div class="welcome-title">
                <span class="sparkle-icon">✦</span>
                <span>歡迎來到 米胡電競</span>
                <span class="sparkle-icon">✦</span>
            </div>

            <div class="welcome-subtitle">
                新的一天 從米胡出發! Let go ~
            </div>

            <% if (typeof error !== 'undefined' && error) { %>
                <div class="alert alert-mihu py-2 px-3 d-flex align-items-center mb-3 text-start" role="alert">
                    <i class="fa-solid fa-circle-exclamation me-2 fs-5 text-danger"></i>
                    <div><%= error %></div>
                </div>
            <% } %>

            <!-- 登入按鈕 -->
            <div class="d-flex justify-content-center">
                <a href="/auth/discord" class="btn btn-discord">
                    <i class="fa-brands fa-discord fs-5"></i>
                    <span>使用 Discord 帳號登入</span>
                </a>
            </div>
        </div>

        <!-- 3 個特色小卡：專業、可愛、成就 -->
        <div class="features-bar">
            <div class="feature-badge">
                <i class="fa-solid fa-crosshairs"></i>
                <span>專業</span>
            </div>
            <div class="feature-badge">
                <i class="fa-solid fa-heart" style="color: var(--mihu-pink);"></i>
                <span>可愛</span>
            </div>
            <div class="feature-badge">
                <i class="fa-solid fa-trophy" style="color: var(--mihu-yellow);"></i>
                <span>成就</span>
            </div>
        </div>
    </div>
</main>

<!-- 頁尾署名 -->
<footer class="bottom-footer">
    MIHU GAMING · 覓狐娛樂工作室 © 2026 ALL RIGHTS RESERVED
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>