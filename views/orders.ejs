<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>訂單管理 · 米胡電競 MiHu Gaming</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        html, body {
            background-color: #0b0914 !important;
            color: #f3f4f6 !important;
            height: 100%;
            margin: 0;
            overflow: hidden;
        }

        .app-layout {
            display: flex;
            width: 100vw;
            height: 100vh;
            overflow: hidden;
        }

        .main-wrapper {
            flex: 1;
            display: flex;
            flex-direction: column;
            height: 100vh;
            overflow: hidden;
            min-width: 0;
        }

        .content-body {
            padding: 24px;
            flex: 1;
            overflow-y: auto;
            display: flex;
            flex-direction: column;
        }

        .page-header-content {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 16px;
            flex-wrap: wrap;
            gap: 14px;
        }

        .glass-table-card {
            background: rgba(23, 19, 38, 0.85) !important;
            border: 1px solid rgba(168, 85, 247, 0.2) !important;
            border-radius: 20px;
            overflow: hidden;
            box-shadow: 0 14px 36px rgba(0, 0, 0, 0.45);
        }

        .table-responsive-scroll { 
            margin: 0; 
            max-height: 520px; 
            overflow-y: auto !important; 
            overflow-x: auto;
            scrollbar-width: thin;
            scrollbar-color: rgba(168, 85, 247, 0.4) transparent;
        }

        .mihu-table {
            width: 100%;
            margin-bottom: 0;
            color: #f3f4f6 !important;
            border-collapse: separate;
            border-spacing: 0;
        }

        .mihu-table th {
            background: #131021 !important;
            color: #94a3b8 !important;
            font-weight: 700;
            font-size: 0.84rem;
            text-transform: uppercase;
            letter-spacing: 0.6px;
            padding: 16px 20px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.08) !important;
            white-space: nowrap;
            position: sticky;
            top: 0;
            z-index: 10;
        }

        .mihu-table td {
            padding: 15px 20px;
            vertical-align: middle;
            border-bottom: 1px solid rgba(255, 255, 255, 0.05) !important;
            font-size: 0.92rem;
            white-space: nowrap;
            color: #f3f4f6 !important;
        }

        .mihu-table tbody tr.order-row {
            cursor: pointer;
            transition: background 0.15s ease;
        }
        .mihu-table tbody tr.order-row:hover {
            background: rgba(168, 85, 247, 0.12) !important;
        }

        .filter-tabs {
            display: flex;
            gap: 8px;
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 255, 255, 0.08);
            padding: 4px;
            border-radius: 14px;
            flex-wrap: wrap;
        }
        .filter-tab-btn {
            background: transparent;
            border: none;
            color: #94a3b8;
            font-size: 0.84rem;
            font-weight: 600;
            padding: 6px 14px;
            border-radius: 10px;
            transition: all 0.2s ease;
            cursor: pointer;
        }
        .filter-tab-btn:hover { color: #fff; }
        .filter-tab-btn.active {
            background: rgba(168, 85, 247, 0.25);
            color: #fff;
            border: 1px solid rgba(168, 85, 247, 0.4);
            box-shadow: 0 0 10px rgba(168, 85, 247, 0.25);
        }

        .search-box-wrap { position: relative; width: 280px; flex-shrink: 0; }
        .search-input-glass {
            background-color: rgba(255, 255, 255, 0.05) !important;
            border: 1px solid rgba(255, 255, 255, 0.14) !important;
            color: #ffffff !important;
            border-radius: 30px;
            padding: 8px 36px 8px 38px;
            font-size: 0.88rem;
            width: 100%;
        }
        .search-icon-left { position: absolute; left: 14px; top: 50%; transform: translateY(-50%); color: #94a3b8; font-size: 0.88rem; }
        .search-clear-btn { position: absolute; right: 12px; top: 50%; transform: translateY(-50%); color: #94a3b8; display: none; border: none; background: transparent; }

        .user-mini-col { display: flex; align-items: center; gap: 10px; }
        .user-mini-avatar { width: 34px; height: 34px; border-radius: 50%; object-fit: cover; border: 1px solid rgba(255, 255, 255, 0.15); }

        .category-badge { font-size: 0.78rem; font-weight: 700; padding: 4px 12px; border-radius: 20px; display: inline-flex; align-items: center; gap: 6px; }
        .badge-陪玩單   { background: rgba(168, 85, 247, 0.18); border: 1px solid rgba(168, 85, 247, 0.4); color: #d8b4fe; }
        .badge-禮物單   { background: rgba(236, 72, 153, 0.18); border: 1px solid rgba(236, 72, 153, 0.4); color: #f472b6; }
        .badge-有獎     { background: rgba(56, 189, 248, 0.18); border: 1px solid rgba(56, 189, 248, 0.4); color: #7dd3fc; }
        .badge-冠名     { background: rgba(245, 158, 11, 0.18); border: 1px solid rgba(245, 158, 11, 0.4); color: #fde047; }
        .badge-獎金     { background: rgba(16, 185, 129, 0.18); border: 1px solid rgba(16, 185, 129, 0.4); color: #6ee7b7; }

        .status-badge { display: inline-flex; align-items: center; gap: 5px; padding: 4px 10px; border-radius: 20px; font-size: 0.76rem; font-weight: 700; }
        .status-badge-pending   { background: rgba(245, 158, 11, 0.15); border: 1px solid rgba(245, 158, 11, 0.4); color: #fde047; }
        .status-badge-active    { background: rgba(56, 189, 248, 0.15); border: 1px solid rgba(56, 189, 248, 0.4); color: #38bdf8; }
        .status-badge-completed { background: rgba(16, 185, 129, 0.15); border: 1px solid rgba(16, 185, 129, 0.4); color: #34d399; }
        .status-badge-cancelled { background: rgba(239, 68, 68, 0.15); border: 1px solid rgba(239, 68, 68, 0.4); color: #f87171; }
        .status-badge-rejected  { background: rgba(148, 163, 184, 0.15); border: 1px solid rgba(148, 163, 184, 0.3); color: #94a3b8; }
    </style>
</head>
<body>

<div class="app-layout">
    <%- include('partials/sidebar', { activePage: 'orders' }) %>

    <div class="main-wrapper">
        <%- include('partials/navbar', { activePage: 'orders' }) %>

        <div class="content-body">
            <div class="page-header-content">
                <div>
                    <div class="h4 fw-bold text-white mb-1">
                        <i class="fa-solid fa-list-check text-pink me-2"></i>工作室訂單管理
                    </div>
                    <p class="text-secondary small mb-0">即時監控與核算工作室訂單收益 (點擊任意訂單列即可檢視詳情或進行編輯)</p>
                </div>

                <div class="search-box-wrap">
                    <i class="fa-solid fa-magnifying-glass search-icon-left"></i>
                    <input type="text" id="orderSearchInput" class="search-input-glass" placeholder="搜尋單號 / 客服 / 闆闆 / 陪陪 / 類別 / 項目...">
                    <button type="button" id="clearSearchBtn" class="search-clear-btn" title="清除搜尋"><i class="fa-solid fa-circle-xmark"></i></button>
                </div>
            </div>

            <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                <div class="filter-tabs">
                    <button type="button" class="filter-tab-btn active" data-filter="all">全部訂單 (<%= orders ? orders.length : 0 %>)</button>
                    <button type="button" class="filter-tab-btn" data-filter="pending">派單中</button>
                    <button type="button" class="filter-tab-btn" data-filter="active">進行中</button>
                    <button type="button" class="filter-tab-btn" data-filter="completed">已完成</button>
                    <button type="button" class="filter-tab-btn" data-filter="cancelled">售後中</button>
                    <button type="button" class="filter-tab-btn" data-filter="rejected">已駁回</button>
                </div>
            </div>

            <% if (typeof success !== 'undefined' && success) { %>
                <div class="alert alert-success py-2 px-3 small mb-3 border-0 bg-success bg-opacity-25 text-success">
                    ✅ 訂單狀態與資料已成功更新！
                </div>
            <% } %>

            <div class="glass-table-card">
                <div class="table-responsive-scroll">
                    <table class="mihu-table" id="ordersTable">
                        <thead>
                            <tr>
                                <th style="width: 13%;">訂單編號</th>
                                <th style="width: 12%;">負責客服</th>
                                <th style="width: 13%;">闆闆</th>
                                <th style="width: 13%;">陪陪</th>
                                <th style="width: 10%;">類別</th>
                                <th style="width: 12%;">項目</th>
                                <th style="width: 12%;">內容</th>
                                <th style="width: 8%;">數量 / 時長</th>
                                <th style="width: 9%;">訂單金額</th>
                                <th style="width: 8%; text-align: center;">狀態</th>
                            </tr>
                        </thead>
                        <tbody id="ordersTableBody">
                            <% if (!orders || orders.length === 0) { %>
                                <tr>
                                    <td colspan="10" class="text-center py-5 text-secondary">目前尚無相關訂單紀錄</td>
                                </tr>
                            <% } else { %>
                                <% orders.forEach(o => { 
                                    // 1. 客服資訊 (優先讀取執行 /派單 指令的使用者)
                                    const csName = o.cs_nickname || o.cs_global_name || o.cs_username || o.cs_name || '米胡客服';
                                    const csAvatar = o.cs_avatar 
                                        ? `https://cdn.discordapp.com/avatars/${o.cs_id}/${o.cs_avatar}.png`
                                        : `https://cdn.discordapp.com/embed/avatars/2.png`;

                                    // 2. 闆闆與陪陪資訊
                                    const bossAvatar = o.boss_avatar 
                                        ? `https://cdn.discordapp.com/avatars/${o.boss_id}/${o.boss_avatar}.png` 
                                        : `https://cdn.discordapp.com/embed/avatars/0.png`;
                                    const bossName = o.boss_nickname || o.boss_global_name || o.boss_username || '匿名闆闆';

                                    const talentAvatar = o.talent_avatar 
                                        ? `https://cdn.discordapp.com/avatars/${o.talent_id}/${o.talent_avatar}.png` 
                                        : `https://cdn.discordapp.com/embed/avatars/1.png`;
                                    const talentName = o.talent_id ? (o.talent_nickname || o.talent_global_name || o.talent_username || '陪玩師') : '派單中';

                                    const category = o.category || o.extra || '陪玩單';
                                    const itemName = o.game || o.item_name || '一般';
                                    const contentTier = o.content_tier || o.note || '-';
                                    const unit = o.unit || '小時';

                                    const statusMap = {
                                        'pending': { name: '派單中', class: 'status-badge-pending', icon: 'fa-clock', group: 'pending' },
                                        'accepted': { name: '進行中', class: 'status-badge-active', icon: 'fa-gamepad', group: 'active' },
                                        'active': { name: '進行中', class: 'status-badge-active', icon: 'fa-gamepad', group: 'active' },
                                        'in_progress': { name: '進行中', class: 'status-badge-active', icon: 'fa-gamepad', group: 'active' },
                                        'completed': { name: '已完成', class: 'status-badge-completed', icon: 'fa-circle-check', group: 'completed' },
                                        'cancelled': { name: '售後中', class: 'status-badge-cancelled', icon: 'fa-triangle-exclamation', group: 'cancelled' },
                                        'rejected': { name: '已駁回', class: 'status-badge-rejected', icon: 'fa-ban', group: 'rejected' }
                                    };
                                    const statusObj = statusMap[o.status] || { name: '進行中', class: 'status-badge-active', icon: 'fa-gamepad', group: 'active' };

                                    const totalAmount = Number(o.total_amount || 0);
                                    const discount = Number(o.discount || 0);
                                    const originalPrice = totalAmount + discount;

                                    const myAdminId = "604610298581876746";
                                    const canEdit = (typeof currentUser !== 'undefined' && currentUser && (currentUser.id === myAdminId || currentUser.role === 'admin')) || 
                                                    (typeof userPerms !== 'undefined' && (userPerms.includes('manage_orders') || userPerms.includes('orders_edit_and_reassign')));

                                    const orderObj = {
                                        id: o.id,
                                        orderNo: o.order_no,
                                        bossId: o.boss_id,
                                        bossName: bossName,
                                        bossAvatar: bossAvatar,
                                        talentId: o.talent_id || '',
                                        talentName: talentName,
                                        talentAvatar: talentAvatar,
                                        csId: o.cs_id || '',
                                        csName: csName,
                                        csAvatar: csAvatar,
                                        category: category,
                                        itemName: itemName,
                                        contentTier: contentTier,
                                        duration: o.duration,
                                        unit: unit,
                                        originalPrice: originalPrice,
                                        discount: discount,
                                        totalAmount: totalAmount,
                                        extra: o.extra || '無特別條件',
                                        note: o.note || '無特別備註',
                                        talentMessage: o.talent_message || o.review_comment || '尚無留言',
                                        status: o.status,
                                        statusName: statusObj.name,
                                        startTime: o.start_time || '尚未開始',
                                        endTime: o.end_time || '尚未結束',
                                        createdAt: o.created_at || o.created_time || o.order_date || '未記錄時間',
                                        canEdit: canEdit
                                    };
                                %>
                                    <tr class="order-row" 
                                        data-status="<%= statusObj.group %>"
                                        data-search="<%= `${o.order_no} ${csName} ${bossName} ${talentName} ${category} ${itemName} ${contentTier}`.toLowerCase() %>"
                                        onclick="openUnifiedModal(this)">
                                        
                                        <script type="application/json" class="order-data-json">
                                            <%- JSON.stringify(orderObj) %>
                                        </script>

                                        <td>
                                            <div class="fw-bold font-monospace text-light"><%= o.order_no %></div>
                                            <div class="small text-secondary font-monospace" style="font-size: 0.72rem;"><%= (o.created_at || '').slice(0, 16) %></div>
                                        </td>

                                        <!-- 🚀 欄位：負責客服 (自動抓取下單指令發起人) -->
                                        <td>
                                            <div class="user-mini-col">
                                                <img src="<%= csAvatar %>" alt="客服頭像" class="user-mini-avatar" style="border-color: rgba(56, 189, 248, 0.4);">
                                                <div>
                                                    <div class="fw-bold text-info small"><%= csName %></div>
                                                    <div class="text-secondary font-monospace" style="font-size: 0.68rem;"><%= o.cs_id ? `•••• ${o.cs_id.slice(-4)}` : '派單客服' %></div>
                                                </div>
                                            </div>
                                        </td>

                                        <td>
                                            <div class="user-mini-col">
                                                <img src="<%= bossAvatar %>" alt="闆闆頭像" class="user-mini-avatar">
                                                <div>
                                                    <div class="fw-bold text-white small"><%= bossName %></div>
                                                    <div class="text-secondary font-monospace" style="font-size: 0.68rem;">•••• <%= (o.boss_id || '').slice(-4) %></div>
                                                </div>
                                            </div>
                                        </td>

                                        <td>
                                            <div class="user-mini-col">
                                                <% if (o.talent_id) { %>
                                                    <img src="<%= talentAvatar %>" alt="陪陪頭像" class="user-mini-avatar" style="border-color: rgba(168, 85, 247, 0.4);">
                                                    <div>
                                                        <div class="fw-bold text-light small"><%= talentName %></div>
                                                        <div class="text-secondary font-monospace" style="font-size: 0.68rem;">•••• <%= (o.talent_id || '').slice(-4) %></div>
                                                    </div>
                                                <% } else { %>
                                                    <div class="badge bg-warning text-dark px-2 py-1" style="font-size: 0.74rem;">
                                                        <i class="fa-solid fa-hourglass-start me-1"></i>派單中
                                                    </div>
                                                <% } %>
                                            </div>
                                        </td>

                                        <td><span class="category-badge badge-<%= category %>"><%= category %></span></td>
                                        <td><span class="fw-bold text-white small"><%= itemName %></span></td>
                                        <td><span class="text-white-50 small text-truncate d-inline-block" style="max-width: 120px;" title="<%= contentTier %>"><%= contentTier %></span></td>
                                        <td><span class="font-monospace text-light small"><%= o.duration %> <%= unit %></span></td>
                                        <td><span class="font-monospace text-warning fw-bold">$<%= Number(o.total_amount).toLocaleString() %></span> <span class="small text-secondary">NTD</span></td>

                                        <td class="text-center">
                                            <span class="status-badge <%= statusObj.class %>">
                                                <i class="fa-solid <%= statusObj.icon %>"></i>
                                                <span><%= statusObj.name %></span>
                                            </span>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } %>
                        </tbody>
                    </table>

                    <div id="noMatchRow" class="text-center py-5 text-secondary" style="display: none;">
                        <i class="fa-solid fa-receipt fs-3 mb-2 opacity-50"></i>
                        <p class="small mb-0">找不到符合條件的訂單記錄</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include('modals/order_detail_modal') %>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
    function setVal(id, val) {
        const el = document.getElementById(id);
        if (el) el.value = (val !== undefined && val !== null) ? val : '';
    }
    function setText(id, txt) {
        const el = document.getElementById(id);
        if (el) el.textContent = (txt !== undefined && txt !== null) ? txt : '--';
    }

    function getOrderData(rowEl) {
        if (!rowEl) return null;
        const scriptEl = rowEl.querySelector('.order-data-json');
        if (!scriptEl) return null;
        try {
            return JSON.parse(scriptEl.textContent.trim());
        } catch (e) {
            console.error('❌ JSON 解析失敗:', e);
            return null;
        }
    }

    function openUnifiedModal(rowEl) {
        const data = getOrderData(rowEl);
        if (!data) return;

        window.currentOrderCanEdit = !!data.canEdit;

        const form = document.getElementById('modalOrderEditForm');
        if (form) form.action = `/management/orders/update/${data.id}`;

        // 展示基本詳情
        setText('detailOrderNo', data.orderNo);
        setText('detailCreatedAt', data.createdAt);
        setText('detailStatusAndCs', `${data.statusName || '進行中'} / ${data.csName || '米胡客服'}`);
        setText('detailCsInfo', data.csName ? `${data.csName} (@${data.csId || 'CS'})` : '米胡客服');
        setText('detailBossInfo', data.bossName ? `${data.bossName} (@${data.bossId})` : '--');
        setText('detailTalentInfo', data.talentId ? `${data.talentName} (@${data.talentId})` : '派單中 (尚未指派)');
        setText('detailExtra', (data.extra && data.extra.trim() !== '' && data.extra !== '無') ? data.extra : '無特別條件');

        // 填寫金額明細專區
        setText('detailOriginalPrice', `$${Number(data.originalPrice || data.totalAmount).toLocaleString()}`);
        setText('detailDiscount', data.discount ? `-$${Number(data.discount).toLocaleString()}` : '$0');
        setText('detailTotalAmountText', `$${Number(data.totalAmount).toLocaleString()} NTD`);

        // 可調整規格
        setVal('editCategory', data.category || '陪玩單');
        setVal('editGame', data.itemName);
        setVal('editContentTier', data.contentTier);
        setVal('editDuration', data.duration || 1);
        setVal('editUnit', data.unit || '小時');
        setVal('editOrderStatus', data.status || 'pending');
        setVal('editTalentMessage', data.talentMessage);
        setVal('editNote', data.note);

        if (typeof switchEditMode === 'function') {
            switchEditMode(false);
        }

        const modalEl = document.getElementById('orderDetailModal');
        if (modalEl) {
            const instance = bootstrap.Modal.getOrCreateInstance(modalEl);
            instance.show();
        }
    }

    document.addEventListener('DOMContentLoaded', () => {
        const rows = document.querySelectorAll('.order-row');
        const searchInput = document.getElementById('orderSearchInput');
        const clearBtn = document.getElementById('clearSearchBtn');
        const noMatchRow = document.getElementById('noMatchRow');
        const filterTabs = document.querySelectorAll('.filter-tab-btn');

        let currentFilter = 'all';

        function applyFilters() {
            const query = searchInput ? searchInput.value.trim().toLowerCase() : '';
            let visibleCount = 0;

            rows.forEach(row => {
                const searchData = row.getAttribute('data-search') || '';
                const rowStatus = row.getAttribute('data-status') || '';

                const matchesQuery = query === '' || searchData.includes(query);
                const matchesFilter = currentFilter === 'all' || rowStatus === currentFilter;

                if (matchesQuery && matchesFilter) {
                    row.style.display = '';
                    visibleCount++;
                } else {
                    row.style.display = 'none';
                }
            });

            if (noMatchRow) noMatchRow.style.display = visibleCount === 0 ? 'block' : 'none';
        }

        if (searchInput) {
            searchInput.addEventListener('input', () => {
                if (clearBtn) clearBtn.style.display = searchInput.value.trim().length > 0 ? 'block' : 'none';
                applyFilters();
            });
        }

        if (clearBtn) {
            clearBtn.addEventListener('click', () => {
                searchInput.value = '';
                clearBtn.style.display = 'none';
                applyFilters();
                searchInput.focus();
            });
        }

        filterTabs.forEach(tab => {
            tab.addEventListener('click', () => {
                filterTabs.forEach(t => t.classList.remove('active'));
                tab.classList.add('active');
                currentFilter = tab.getAttribute('data-filter');
                applyFilters();
            });
        });
    });
</script>
<%- include('partials/feature_modal') %>
</body>
</html>