<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>我的錢包 · 米胡電競 MiHu Gaming</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        html, body {
            background-color: #0b0914 !important;
            color: #f3f4f6 !important;
            height: 100%;
            margin: 0;
            overflow: hidden;
        }

        .app-layout {
            display: flex;
            width: 100vw;
            height: 100vh;
            overflow: hidden;
        }

        .main-wrapper {
            flex: 1;
            display: flex;
            flex-direction: column;
            height: 100vh;
            overflow: hidden;
            min-width: 0;
        }

        .content-body {
            padding: 28px;
            flex: 1;
            overflow-y: auto;
            display: flex;
            flex-direction: column;
        }

        .glass-panel-card {
            background: rgba(19, 16, 33, 0.85) !important;
            border: 1px solid rgba(255, 255, 255, 0.08) !important;
            border-radius: 24px;
            padding: 28px;
            box-shadow: 0 14px 36px rgba(0, 0, 0, 0.45);
        }

        .balance-divider {
            border-right: 1px solid rgba(255, 255, 255, 0.08);
        }
        @media (max-width: 768px) {
            .balance-divider { border-right: none; border-bottom: 1px solid rgba(255, 255, 255, 0.08); padding-bottom: 16px; }
        }
    </style>
</head>
<body>

<div class="app-layout">
    <%- include('partials/sidebar', { activePage: 'wallet' }) %>

    <div class="main-wrapper">
        <%- include('partials/navbar', { activePage: 'wallet' }) %>

        <div class="content-body">
            <!-- 上半部：3D 電競信用卡與餘額數據 -->
            <div class="glass-panel-card mb-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <div class="h4 fw-bold text-white mb-1 d-flex align-items-center gap-2">
                            <i class="fa-solid fa-wallet" style="color: #a855f7;"></i>
                            <span>我的錢包</span>
                        </div>
                        <p class="text-secondary small mb-0">個人儲值餘額與尊榮 VIP 身分卡 (點擊卡片檢視詳情)</p>
                    </div>
                </div>

                <!-- 💳 1. 模組化 3D 信用卡區 (點擊觸發 Modal) -->
                <div class="d-flex justify-content-center my-3" style="cursor: pointer;" onclick="openWalletDetailModal()">
                    <%- include('partials/wallet_card', { user: user }) %>
                </div>

                <hr class="border-secondary border-opacity-25 my-4">

                <!-- 💰 2. 下方實充餘額 / 贈送餘額區 -->
                <% 
                    const realBalance = Number(user.real_balance || user.balance || 0);
                    const bonusBalance = Number(user.bonus_balance || 0);
                    const userAvatar = user.avatar ? `https://cdn.discordapp.com/avatars/${user.id}/${user.avatar}.png` : `https://cdn.discordapp.com/embed/avatars/0.png`;
                    const userName = user.nickname || user.global_name || user.username || '會員闆闆';

                    const walletObj = {
                        id: user.id,
                        name: userName,
                        avatar: userAvatar,
                        balance: user.balance || 0,
                        realBalance: realBalance,
                        bonusBalance: bonusBalance
                    };
                %>
                <!-- 隱藏式 JSON 資料 -->
                <script type="application/json" id="walletDataJson">
                    <%- JSON.stringify(walletObj) %>
                </script>

                <div class="row text-center py-2">
                    <div class="col-6 balance-divider">
                        <div class="text-secondary small mb-2 fw-semibold"><i class="fa-solid fa-money-bill-wave text-success me-1"></i>實充餘額</div>
                        <div class="fs-4 fw-bold text-white font-monospace">$<%= realBalance.toLocaleString() %></div>
                    </div>
                    <div class="col-6">
                        <div class="text-secondary small mb-2 fw-semibold"><i class="fa-solid fa-gift text-warning me-1"></i>贈送餘額</div>
                        <div class="fs-4 fw-bold text-warning font-monospace">$<%= bonusBalance.toLocaleString() %></div>
                    </div>
                </div>
            </div>

            <!-- 👑 3. 獨立模組化：VIP 自動判定較高進度與流光進度條 -->
            <div class="mb-4">
                <%- include('partials/vip_progress_card', { 
                    user: user, 
                    stats: stats, 
                    progressPercent: progressPercent, 
                    vipGapText: vipGapText 
                }) %>
            </div>

            <!-- 📜 4. 獨立模組化：消費歷史與帳戶流水頁籤區 (限制 5 則高度滾動) -->
            <%- include('partials/wallet_history', { orders: orders, transactions: transactions, topups: topups, user: user }) %>
        </div>
    </div>
</div>

<!-- 🚀 獨立錢包詳情 Modal -->
<%- include('modals/wallet_modal') %>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
    function setText(id, txt) {
        const el = document.getElementById(id);
        if (el) el.textContent = (txt !== undefined && txt !== null && txt !== '') ? txt : '--';
    }

    function openWalletDetailModal() {
        const scriptEl = document.getElementById('walletDataJson');
        if (!scriptEl) return;

        try {
            const data = JSON.parse(scriptEl.textContent.trim());

            setText('walletModalUserName', data.name);
            setText('walletModalUserId', `ID: ${data.id}`);
            setText('walletModalBalance', `$${Number(data.balance || 0).toLocaleString()}`);
            setText('walletModalRealBalance', `$${Number(data.realBalance || 0).toLocaleString()}`);
            setText('walletModalBonusBalance', `$${Number(data.bonusBalance || 0).toLocaleString()}`);

            const avatarEl = document.getElementById('walletModalAvatar');
            if (avatarEl && data.avatar) avatarEl.src = data.avatar;

            const modalEl = document.getElementById('walletDetailModal');
            if (modalEl) {
                const instance = bootstrap.Modal.getOrCreateInstance(modalEl);
                instance.show();
            }
        } catch (e) {
            console.error('❌ 解析錢包 JSON 失敗:', e);
        }
    }
</script>
<%- include('partials/feature_modal') %>
</body>
</html>