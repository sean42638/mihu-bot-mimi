<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>我的錢包 · 米胡電競 MiHu Gaming</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --bg-color: #0b0914;
            --sidebar-bg: #131021;
            --card-bg: rgba(23, 19, 38, 0.85);
            --card-border: rgba(168, 85, 247, 0.2);
            --mihu-purple: #9333ea;
            --mihu-purple-light: #c084fc;
            --mihu-yellow: #fde047;
            --text-light: #f3f4f6;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            background-color: var(--bg-color);
            color: var(--text-light);
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            display: flex;
            min-height: 100vh;
            overflow-x: hidden;
        }

        img { max-width: 100%; height: auto; }

        .mihu-sidebar {
            width: 280px !important;
            min-width: 280px !important;
            max-width: 280px !important;
            background-color: var(--sidebar-bg);
            border-right: 1px solid var(--card-border);
            display: flex;
            flex-direction: column;
            justify-content: flex-start;
            padding: 24px 16px;
            flex-shrink: 0;
            height: 100vh;
            position: sticky;
            top: 0;
            overflow-x: hidden;
            overflow-y: auto;
        }
        .sidebar-brand-clean {
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 8px 10px 18px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
            margin-bottom: 12px;
            width: 100%;
        }
        .brand-logo-clean {
            width: 170px !important;
            max-width: 170px !important;
            height: auto !important;
            object-fit: contain !important;
            filter: drop-shadow(0 0 16px rgba(168, 85, 247, 0.5));
            transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        }
        .brand-logo-clean:hover { transform: scale(1.05); }

        .main-wrapper {
            flex-grow: 1;
            display: flex;
            flex-direction: column;
            overflow-y: auto;
            max-height: 100vh;
            width: calc(100vw - 280px);
            min-width: 0;
        }

        .content-body { padding: 20px 36px 32px; flex-grow: 1; }

        /* 圖 2 樣式大標題 */
        .page-header-content {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 18px;
            flex-wrap: wrap;
            gap: 14px;
            width: 100%;
        }

        .page-title-text {
            font-size: 1.5rem;
            font-weight: 800;
            color: #ffffff;
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 4px;
        }

        .glass-card {
            background: var(--card-bg);
            border: 1px solid var(--card-border);
            border-radius: 20px;
            padding: 28px;
            backdrop-filter: blur(15px);
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
            height: 100%;
        }

        /* VIP 晶片卡 */
        .wallet-card-container {
            position: relative;
            width: 100%;
            max-width: 440px;
            min-height: 240px;
            border-radius: 22px;
            padding: 24px 26px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            overflow: hidden;
            box-shadow: 0 16px 36px rgba(0, 0, 0, 0.5);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }
        .wallet-card-container:hover {
            transform: translateY(-4px);
            box-shadow: 0 22px 45px rgba(0, 0, 0, 0.65);
        }

        .vip-theme-0 { background: linear-gradient(135deg, #1e1b29 0%, #110e1a 100%); border: 1px solid rgba(255, 255, 255, 0.12); }
        .vip-theme-1, .vip-theme-2 { background: linear-gradient(135deg, #3b0764 0%, #1e1136 60%, #100b1e 100%); border: 1px solid rgba(168, 85, 247, 0.4); }
        .vip-theme-3, .vip-theme-4 { background: linear-gradient(135deg, #064e3b 0%, #0f172a 50%, #1e1b4b 100%); border: 1px solid rgba(56, 189, 248, 0.45); }
        .vip-theme-5, .vip-theme-6 { background: linear-gradient(135deg, #78350f 0%, #311804 50%, #190c02 100%); border: 1px solid rgba(250, 204, 21, 0.45); }
        .vip-theme-7 { background: radial-gradient(circle at 10% 20%, #2e1065 0%, #0d0914 80%), linear-gradient(135deg, #4c1d95 0%, #000000 100%); border: 1px solid rgba(253, 224, 71, 0.6); }

        .card-chip {
            width: 44px; height: 32px;
            background: linear-gradient(135deg, #fbbf24 0%, #d97706 100%);
            border-radius: 6px; position: relative;
            box-shadow: inset 0 1px 2px rgba(255, 255, 255, 0.4), 0 2px 4px rgba(0,0,0,0.4);
        }
        .card-chip::after {
            content: ''; position: absolute; top: 50%; left: 0; width: 100%; height: 1px; background: rgba(0, 0, 0, 0.35);
        }
        .card-watermark {
            position: absolute; right: -25px; bottom: -25px; width: 180px; height: auto; opacity: 0.08; pointer-events: none;
        }
        .card-balance-num { font-size: 1.95rem; font-weight: 800; color: #ffffff; text-shadow: 0 2px 10px rgba(0, 0, 0, 0.5); line-height: 1; }
        .card-vip-badge {
            background: rgba(255, 255, 255, 0.12); border: 1px solid rgba(255, 255, 255, 0.2); padding: 5px 14px; border-radius: 30px; font-weight: 800; font-size: 0.88rem; display: inline-flex; align-items: center; gap: 6px;
        }

        /* 霓虹進度條 */
        .progress-neon-wrap {
            background: rgba(255, 255, 255, 0.04);
            border-radius: 10px;
            height: 14px;
            width: 100%;
            overflow: hidden;
            position: relative;
            border: 1px solid rgba(255, 255, 255, 0.08);
            margin: 12px 0 6px 0;
        }
        .progress-neon-bar {
            background: linear-gradient(90deg, #9333ea, #ec4899, #fde047);
            height: 100%;
            border-radius: 10px;
            box-shadow: 0 0 16px rgba(168, 85, 247, 0.85);
            width: var(--target-width, 0%);
            animation: neonGrow 1.3s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }

        @keyframes neonGrow {
            0% { width: 0%; }
            100% { width: var(--target-width, 0%); }
        }

        .scrollable-modal-table-wrap {
            max-height: 310px;
            overflow-y: auto;
            overflow-x: auto;
        }
        .scrollable-modal-table-wrap::-webkit-scrollbar { width: 5px; height: 5px; }
        .scrollable-modal-table-wrap::-webkit-scrollbar-thumb {
            background: rgba(168, 85, 247, 0.35);
            border-radius: 4px;
        }

        .mihu-table { width: 100%; margin-bottom: 0; color: #f3f4f6; border-collapse: separate; border-spacing: 0; }
        .mihu-table th {
            background: rgba(0, 0, 0, 0.55); color: #94a3b8; font-weight: 700; font-size: 0.84rem; text-transform: uppercase; letter-spacing: 0.5px; padding: 14px 18px; border-bottom: 1px solid rgba(255, 255, 255, 0.08); white-space: nowrap; position: sticky; top: 0; z-index: 2;
        }
        .mihu-table td { padding: 13px 18px; vertical-align: middle; border-bottom: 1px solid rgba(255, 255, 255, 0.05); font-size: 0.9rem; white-space: nowrap; }
        .mihu-table tbody tr:hover { background: rgba(168, 85, 247, 0.08); }
        .mihu-table tbody tr:last-child td { border-bottom: none; }

        .modal-content-glass {
            background: rgba(20, 16, 35, 0.97);
            border: 1px solid rgba(168, 85, 247, 0.35);
            border-radius: 20px;
            box-shadow: 0 25px 60px rgba(0, 0, 0, 0.8), 0 0 30px rgba(168, 85, 247, 0.25);
            backdrop-filter: blur(25px);
            color: #fff;
        }
    </style>
</head>
<body>

<%- include('partials/sidebar', { activePage: 'wallet' }) %>

<div class="main-wrapper">
    <%- include('partials/navbar', { activePage: 'wallet' }) %>

    <div class="content-body">
        <!-- 🚀 圖 2 樣式大標題 -->
        <div class="page-header-content">
            <div>
                <div class="page-title-text">
                    <i class="fa-solid fa-wallet text-info"></i>
                    <span>我的錢包與資產中心</span>
                </div>
                <p class="text-secondary small mb-0">掌握您的實充餘額、贈送點數、VIP 門檻等級與歷史儲值紀錄</p>
            </div>
        </div>

        <% 
            const userVip = Number(user.vip_level || 0);
            const themeClass = userVip >= 7 ? 'vip-theme-7' : `vip-theme-${userVip}`;
            const totalBalance = (Number(user.balance || 0) + Number(user.bonus_balance || 0)).toLocaleString();
            const safePercent = parseFloat(progressPercent) || 0;
        %>

        <div class="row g-4">
            <!-- 💳 左側：VIP 晶片卡 -->
            <div class="col-xl-5 col-lg-6 col-12">
                <div class="glass-card d-flex flex-column justify-content-between">
                    <div>
                        <h5 class="fw-bold mb-1 text-white">尊榮 VIP 身分晶片卡</h5>
                        <p style="color: #94a3b8;" class="small mb-3">米胡電競官方認證資產憑證</p>
                    </div>

                    <div class="d-flex justify-content-center my-2">
                        <div class="wallet-card-container <%= themeClass %>">
                            <img src="/images/logo2.png" alt="MIHU" class="card-watermark" onerror="this.style.display='none'">

                            <div class="d-flex justify-content-between align-items-center">
                                <div class="d-flex align-items-center gap-2">
                                    <div class="card-chip"></div>
                                    <i class="fa-solid fa-wifi text-secondary fa-rotate-90 opacity-75"></i>
                                </div>
                                <div class="card-vip-badge">
                                    <i class="fa-solid fa-crown text-warning"></i>
                                    <span><%= userVip > 0 ? `VIP ${userVip}` : '一般會員' %></span>
                                </div>
                            </div>

                            <div class="my-3">
                                <span class="small text-white-50 text-uppercase fw-semibold" style="letter-spacing: 1px; font-size: 0.72rem;">Total Balance</span>
                                <div class="d-flex align-items-baseline gap-2 mt-1">
                                    <span class="card-balance-num font-monospace">$<%= totalBalance %></span>
                                    <span class="text-white-50 fw-bold small">NTD</span>
                                </div>
                            </div>

                            <div class="d-flex justify-content-between align-items-end pt-2 border-top border-white border-opacity-10">
                                <div>
                                    <div class="text-white-50" style="font-size: 0.68rem; text-transform: uppercase;">Card Holder</div>
                                    <div class="text-white fw-bold small"><%= user.custom_nickname || user.global_name || user.username %></div>
                                </div>
                                <div class="text-end">
                                    <div class="text-white-50" style="font-size: 0.68rem; text-transform: uppercase;">Member ID</div>
                                    <div class="font-monospace text-white small opacity-75">•••• <%= user.id.slice(-4) %></div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-around mt-3 pt-3 border-top border-secondary border-opacity-25 text-center">
                        <div>
                            <div class="text-secondary small">實充餘額</div>
                            <div class="fw-bold text-white font-monospace mt-1">$<%= Number(user.balance || 0).toLocaleString() %></div>
                        </div>
                        <div class="border-end border-secondary border-opacity-25"></div>
                        <div>
                            <div class="text-secondary small">贈送餘額</div>
                            <div class="fw-bold text-warning font-monospace mt-1">$<%= Number(user.bonus_balance || 0).toLocaleString() %></div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 📈 右側：VIP 升級特權與進度條 -->
            <div class="col-xl-7 col-lg-6 col-12">
                <div class="glass-card h-100 d-flex flex-column justify-content-between">
                    <div>
                        <h5 class="fw-bold mb-1 text-white">
                            <i class="fa-solid fa-arrow-trend-up me-2 text-warning"></i>VIP 升級特權與進度
                        </h5>
                        <p style="color: #94a3b8;" class="small mb-3">解鎖更高階 VIP，享受更多專屬折價券與尊榮權利</p>
                    </div>

                    <div class="p-4 rounded-4" style="background: rgba(0, 0, 0, 0.4); border: 1px solid rgba(255, 255, 255, 0.08);">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="text-secondary small">當前等級地位</span>
                            <span class="badge bg-warning text-dark px-3 py-1 fw-bold">VIP <%= userVip %></span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="text-secondary small">累積消費總額</span>
                            <span class="fw-bold text-white font-monospace">$<%= Number(stats ? stats.total_spent : 0).toLocaleString() %> NTD</span>
                        </div>

                        <!-- 升級霓虹進度條 -->
                        <div class="my-3">
                            <div class="d-flex justify-content-between small text-secondary mb-1">
                                <span>升級進度</span>
                                <span class="font-monospace text-warning fw-bold"><%= safePercent %>%</span>
                            </div>
                            <div class="progress-neon-wrap">
                                <div class="progress-neon-bar" id="neonProgressBar" style="--target-width: <%= safePercent %>%;"></div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center pt-2">
                            <span class="text-secondary small">距下一階差距說明</span>
                            <span class="text-info fw-bold small text-end"><%= vipGapText %></span>
                        </div>
                    </div>

                    <!-- 檢視帳務紀錄 -->
                    <div class="mt-4 pt-2 d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <button type="button" class="btn btn-sm btn-outline-info rounded-pill px-4 py-2 fw-semibold" data-bs-toggle="modal" data-bs-target="#topupHistoryModal">
                            <i class="fa-solid fa-clock-rotate-left me-2"></i>檢視歷史帳務紀錄 (<%= topups ? topups.length : 0 %>)
                        </button>
                        <div class="text-secondary small">
                            <i class="fa-solid fa-circle-info me-1 text-primary"></i> 若有儲值需求請洽官方客服
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- 彈窗：個人帳務紀錄 -->
<div class="modal fade" id="topupHistoryModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg" style="max-width: 860px;">
        <div class="modal-content modal-content-glass p-2">
            <div class="modal-header border-0 pb-2">
                <h5 class="modal-title fw-bold text-white d-flex align-items-center gap-2">
                    <i class="fa-solid fa-clock-rotate-left text-info"></i>
                    <span>個人帳務紀錄</span>
                    <span class="badge bg-secondary bg-opacity-50 small ms-2" style="font-size: 0.75rem;">共 <%= topups ? topups.length : 0 %> 筆</span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-0">
                <div class="scrollable-modal-table-wrap">
                    <table class="mihu-table">
                        <thead>
                            <tr>
                                <th style="width: 24%;">交易編號</th>
                                <th style="width: 13%;">型態</th>
                                <th style="width: 14%;">加值金額</th>
                                <th style="width: 14%;">贈送金額</th>
                                <th style="width: 15%;">入帳管道</th>
                                <th>備註與說明</th>
                                <th style="width: 16%; text-align: right;">時間</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (!topups || topups.length === 0) { %>
                                <tr>
                                    <td colspan="7" class="text-center py-5 text-secondary">目前尚無任何帳務紀錄</td>
                                </tr>
                            <% } else { %>
                                <% topups.forEach(t => { 
                                    const amt = Number(t.amount || 0);
                                    const bonus = Number(t.bonus || 0);
                                    let typeBadge = '<span class="badge bg-success">加值入帳</span>';
                                    if (amt < 0) {
                                        typeBadge = '<span class="badge bg-danger">款項扣款</span>';
                                    } else if (t.channel_type && t.channel_type.includes('調帳')) {
                                        typeBadge = '<span class="badge bg-warning text-dark">後台調帳</span>';
                                    }

                                    const dt = t.created_at ? new Date(t.created_at) : new Date();
                                    const y = dt.getFullYear();
                                    const m = String(dt.getMonth() + 1).padStart(2, '0');
                                    const d = String(dt.getDate()).padStart(2, '0');
                                    const h = String(dt.getHours()).padStart(2, '0');
                                    const min = String(dt.getMinutes()).padStart(2, '0');
                                    const s = String(dt.getSeconds()).padStart(2, '0');
                                    const seq = String(t.id).padStart(4, '0');
                                    const customTxNo = `MHm${y}${m}${d}${h}${min}${s}${seq}`;
                                %>
                                    <tr>
                                        <td><span class="font-monospace text-light fw-bold"><%= customTxNo %></span></td>
                                        <td><%- typeBadge %></td>
                                        <td>
                                            <span class="font-monospace <%= amt >= 0 ? 'text-success' : 'text-danger' %> fw-bold">
                                                <%= amt >= 0 ? `+$${amt.toLocaleString()}` : `-$${Math.abs(amt).toLocaleString()}` %>
                                            </span> <span class="small text-secondary">NTD</span>
                                        </td>
                                        <td>
                                            <span class="font-monospace text-warning fw-bold">+$<%= bonus.toLocaleString() %></span> <span class="small text-secondary">NTD</span>
                                        </td>
                                        <td><span class="badge bg-secondary"><%= t.channel_type || '一般入帳' %></span></td>
                                        <td><span class="text-white-50"><%= t.note || '無' %></span></td>
                                        <td class="text-end font-monospace text-secondary small"><%= (t.created_at || '').slice(0, 16) %></td>
                                    </tr>
                                <% }) %>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer border-0 pt-3">
                <button type="button" class="btn btn-sm btn-secondary rounded-pill px-4" data-bs-dismiss="modal">關閉視窗</button>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>