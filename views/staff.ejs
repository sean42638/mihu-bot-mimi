<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>員工管理 · 米胡電競 MiHu Gaming</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --bg-color: #0b0914;
            --sidebar-bg: #131021;
            --card-bg: rgba(23, 19, 38, 0.85);
            --card-border: rgba(168, 85, 247, 0.2);
            --mihu-purple: #9333ea;
            --mihu-purple-light: #c084fc;
            --mihu-yellow: #fde047;
            --text-light: #f3f4f6;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            background-color: var(--bg-color);
            color: var(--text-light);
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            display: flex;
            min-height: 100vh;
        }

        .mihu-sidebar {
            width: 280px;
            background-color: var(--sidebar-bg);
            border-right: 1px solid var(--card-border);
            display: flex;
            flex-direction: column;
            justify-content: flex-start;
            padding: 24px 16px;
            flex-shrink: 0;
            height: 100vh;
            position: sticky;
            top: 0;
        }
        .sidebar-brand-clean {
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 8px 10px 18px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
            margin-bottom: 12px;
        }
        .brand-logo-clean {
            width: 170px;
            height: auto;
            filter: drop-shadow(0 0 16px rgba(168, 85, 247, 0.5));
            transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        }
        .brand-logo-clean:hover { transform: scale(1.05); }
        
        .sidebar-menu { 
            display: flex; 
            flex-direction: column; 
            gap: 4px; 
            overflow-y: auto;
            padding-right: 4px;
        }
        .sidebar-menu::-webkit-scrollbar { width: 4px; }
        .sidebar-menu::-webkit-scrollbar-thumb {
            background: rgba(168, 85, 247, 0.2);
            border-radius: 4px;
        }

        .menu-label { 
            font-size: 0.74rem; 
            color: #8b83a8; 
            padding: 14px 14px 4px; 
            text-transform: uppercase; 
            font-weight: 700; 
            letter-spacing: 0.8px;
        }
        .menu-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 10px 14px;
            border-radius: 12px;
            color: #9ca3af;
            text-decoration: none;
            font-size: 0.92rem;
            font-weight: 500;
            transition: all 0.2s ease;
        }
        .menu-item i { width: 18px; text-align: center; }
        .menu-item:hover, .menu-item.active {
            color: #fff;
            background: rgba(168, 85, 247, 0.15);
            border: 1px solid rgba(168, 85, 247, 0.25);
        }
        .menu-item.active i { color: var(--mihu-purple-light); }

        .sidebar-collapse-wrap { display: flex; flex-direction: column; }
        .collapse-arrow { transition: transform 0.25s ease; }
        .menu-item[aria-expanded="true"] .collapse-arrow { transform: rotate(180deg); color: #fff !important; }
        .sidebar-submenu-items {
            margin-left: 20px;
            padding-left: 10px;
            border-left: 2px dashed rgba(168, 85, 247, 0.25);
            display: flex;
            flex-direction: column;
            gap: 2px;
            margin-top: 4px;
            margin-bottom: 6px;
        }
        .submenu-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 8px 12px;
            border-radius: 10px;
            color: #94a3b8;
            text-decoration: none;
            font-size: 0.86rem;
            font-weight: 500;
            transition: all 0.2s ease;
        }
        .submenu-item i { width: 16px; text-align: center; font-size: 0.8rem; }
        .submenu-item:hover { color: #fff; background: rgba(168, 85, 247, 0.12); }

        .main-wrapper {
            flex-grow: 1;
            display: flex;
            flex-direction: column;
            overflow-y: auto;
            max-height: 100vh;
        }

        /* 🚀 緊湊合理的頂部間距 */
        .content-body { 
            padding: 16px 36px 32px; 
            flex-grow: 1; 
        }
        
        /* 🚀 搜尋與控制項完全靠右 */
        .page-header {
            display: flex;
            align-items: center;
            justify-content: flex-end;
            margin-bottom: 12px;
            flex-wrap: wrap;
            gap: 14px;
            width: 100%;
        }

        .search-box-wrap {
            position: relative;
            width: 280px;
            flex-shrink: 0;
        }
        .search-input-glass {
            background-color: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.14);
            color: #ffffff !important;
            border-radius: 30px;
            padding: 8px 36px 8px 38px;
            font-size: 0.88rem;
            width: 100%;
            transition: all 0.2s ease;
        }
        .search-input-glass::placeholder { color: #94a3b8 !important; }
        .search-input-glass:focus {
            background-color: rgba(255, 255, 255, 0.08);
            border-color: var(--mihu-purple-light);
            outline: none;
            box-shadow: 0 0 0 3px rgba(168, 85, 247, 0.25);
        }
        .search-icon-left {
            position: absolute;
            left: 14px;
            top: 50%;
            transform: translateY(-50%);
            color: #94a3b8;
            font-size: 0.88rem;
            pointer-events: none;
        }
        .search-clear-btn {
            position: absolute;
            right: 12px;
            top: 50%;
            transform: translateY(-50%);
            color: #94a3b8;
            font-size: 0.82rem;
            cursor: pointer;
            display: none;
            border: none;
            background: transparent;
            padding: 0;
        }
        .search-clear-btn:hover { color: #ffffff; }

        .glass-table-card {
            background: var(--card-bg);
            border: 1px solid var(--card-border);
            border-radius: 20px;
            overflow: hidden;
            box-shadow: 0 14px 36px rgba(0, 0, 0, 0.45);
            backdrop-filter: blur(15px);
        }

        .table-responsive { margin: 0; overflow-x: auto; }
        .mihu-table {
            width: 100%;
            margin-bottom: 0;
            color: #f3f4f6;
            border-collapse: separate;
            border-spacing: 0;
        }
        .mihu-table th {
            background: rgba(0, 0, 0, 0.42);
            color: #94a3b8;
            font-weight: 700;
            font-size: 0.84rem;
            text-transform: uppercase;
            letter-spacing: 0.6px;
            padding: 16px 20px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
            white-space: nowrap;
        }
        .mihu-table td {
            padding: 16px 20px;
            vertical-align: middle;
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
            font-size: 0.92rem;
            white-space: nowrap;
        }
        .mihu-table tbody tr.staff-row {
            cursor: pointer;
            transition: background 0.15s ease;
        }
        .mihu-table tbody tr.staff-row:hover {
            background: rgba(168, 85, 247, 0.09);
        }
        .mihu-table tbody tr:last-child td {
            border-bottom: none;
        }

        .staff-avatar {
            width: 42px;
            height: 42px;
            border-radius: 50%;
            object-fit: cover;
            border: 2px solid rgba(16, 185, 129, 0.45);
            box-shadow: 0 0 10px rgba(16, 185, 129, 0.25);
        }
        .staff-info-col {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .dc-tag-badge {
            background: rgba(88, 101, 242, 0.15);
            border: 1px solid rgba(88, 101, 242, 0.35);
            color: #a5b4fc;
            font-size: 0.74rem;
            padding: 2px 7px;
            border-radius: 6px;
            font-family: monospace;
            display: inline-block;
            margin-top: 2px;
        }

        .role-badge-tag {
            font-size: 0.78rem;
            font-weight: 700;
            padding: 4px 12px;
            border-radius: 20px;
            letter-spacing: 0.4px;
        }

        .status-pill {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 3px 10px;
            border-radius: 20px;
            font-size: 0.78rem;
            font-weight: 700;
        }
        .status-idle {
            background: rgba(16, 185, 129, 0.15);
            border: 1px solid rgba(16, 185, 129, 0.4);
            color: #34d399;
        }
        .status-busy {
            background: rgba(239, 68, 68, 0.15);
            border: 1px solid rgba(239, 68, 68, 0.4);
            color: #f87171;
        }
        .status-leave {
            background: rgba(148, 163, 184, 0.15);
            border: 1px solid rgba(148, 163, 184, 0.4);
            color: #cbd5e1;
        }

        .rate-pill {
            background: rgba(253, 224, 71, 0.12);
            border: 1px solid rgba(253, 224, 71, 0.35);
            color: #fde047;
            font-weight: 700;
            padding: 2px 8px;
            border-radius: 8px;
            font-family: monospace;
            font-size: 0.85rem;
        }

        .channel-code-badge {
            background: rgba(255, 255, 255, 0.04);
            border: 1px solid rgba(255, 255, 255, 0.1);
            color: #cbd5e1;
            font-size: 0.76rem;
            padding: 3px 8px;
            border-radius: 6px;
            font-family: monospace;
        }

        .action-btns-group {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            white-space: nowrap;
        }
        .btn-circle-icon {
            width: 34px;
            height: 34px;
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 0;
            font-size: 0.86rem;
            transition: all 0.2s ease;
        }
        .btn-circle-icon:hover { transform: scale(1.08); }

        .modal-content-glass {
            background: rgba(20, 16, 35, 0.97);
            border: 1px solid rgba(168, 85, 247, 0.35);
            border-radius: 20px;
            box-shadow: 0 25px 60px rgba(0, 0, 0, 0.8), 0 0 30px rgba(168, 85, 247, 0.25);
            backdrop-filter: blur(25px);
            color: #fff;
        }
        .form-control-glass {
            background-color: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.14);
            color: #ffffff !important;
            border-radius: 12px;
            padding: 10px 14px;
            font-size: 0.92rem;
        }
        .form-control-glass:focus {
            background-color: rgba(255, 255, 255, 0.08);
            border-color: var(--mihu-purple-light);
            outline: none;
            box-shadow: 0 0 0 3px rgba(168, 85, 247, 0.25);
        }

        .info-detail-box {
            background: rgba(255, 255, 255, 0.02);
            border: 1px solid rgba(255, 255, 255, 0.06);
            border-radius: 12px;
            padding: 12px 14px;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }
        .info-detail-label {
            font-size: 0.74rem;
            color: #94a3b8;
            margin-bottom: 4px;
        }
        .info-detail-val {
            font-size: 0.95rem;
            font-weight: 700;
            color: #ffffff;
            font-family: monospace;
        }

        .mascot-modal-img {
            width: 160px;
            height: auto;
            margin-bottom: 18px;
            filter: drop-shadow(0 0 20px rgba(168, 85, 247, 0.65));
            animation: mascot-bob 3s ease-in-out infinite;
        }
        @keyframes mascot-bob {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-4px); }
        }
    </style>
</head>
<body>

<%- include('partials/sidebar', { activePage: 'staff' }) %>

<div class="main-wrapper">
    <%- include('partials/navbar', { activePage: 'staff' }) %>

    <div class="content-body">
        <!-- 🚀 修復橫向對齊：左邊顯示標題說明，右邊顯示搜尋與按鈕 -->
        <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
            <div>
                <div class="page-title-text" style="font-size: 1.5rem; font-weight: 800; color: #ffffff; display: flex; align-items: center; gap: 10px; margin-bottom: 4px;">
                    <i class="fa-solid fa-users-gear text-success"></i>
                    <span>員工列表</span>
                </div>
                <p class="text-secondary small mb-0">管理工作室員工與陪玩師身份、分潤抽成及 Discord 工單頻道綁定</p>
            </div>

            <div class="d-flex align-items-center gap-3">
                <div class="search-box-wrap">
                    <i class="fa-solid fa-magnifying-glass search-icon-left"></i>
                    <input type="text" id="staffSearchInput" class="search-input-glass" placeholder="搜尋姓名 / 暱稱 / Discord...">
                    <button type="button" id="clearSearchBtn" class="search-clear-btn" title="清除搜尋">
                        <i class="fa-solid fa-circle-xmark"></i>
                    </button>
                </div>

                <a href="/management/staff/sync-all" class="btn btn-sm btn-outline-success rounded-pill px-3 py-2 fw-semibold text-nowrap flex-shrink-0">
                    <i class="fa-brands fa-discord me-1"></i>同步員工 DC 資料
                </a>
            </div>
        </div>

        <% if (typeof success !== 'undefined' && success) { %>
            <div class="alert alert-success py-2 px-3 small mb-4 border-0 bg-success bg-opacity-25 text-success">
                ✅ 員工狀態、職位與抽佣已成功更新！
            </div>
        <% } %>

        <!-- 員工清單表格 -->
        <div class="glass-table-card">
            <div class="table-responsive">
                <table class="mihu-table" id="staffTable">
                    <thead>
                        <tr>
                            <th style="width: 22%;">員工姓名 / DISCORD</th>
                            <th style="width: 12%; text-align: center;">所屬職位</th>
                            <th style="width: 11%; text-align: center;">當前狀態</th>
                            <th style="width: 12%;">分潤抽佣</th>
                            <th style="width: 13%;">累積接單 / 業績</th>
                            <th style="width: 18%;">Discord 專屬工單頻道</th>
                            <th style="width: 12%; text-align: right;">操作</th>
                        </tr>
                    </thead>
                    <tbody id="staffTableBody">
                        <% staffList.forEach(s => { 
                            const avUrl = s.avatar 
                                ? `https://cdn.discordapp.com/avatars/${s.id}/${s.avatar}.png` 
                                : `https://cdn.discordapp.com/embed/avatars/0.png`;
                            const displayName = s.custom_nickname || s.global_name || s.username;

                            const roleMap = {
                                'admin': { name: '負責人', class: 'bg-danger' },
                                'manager': { name: '店長', class: 'bg-warning text-dark' },
                                'cfo': { name: '財務長', class: 'bg-danger' },
                                'after_sales': { name: '售後管理', class: 'bg-warning text-dark' },
                                'cs_director': { name: '客服主管', class: 'bg-warning text-dark' },
                                'cs': { name: '客服', class: 'bg-info text-dark' },
                                'staff': { name: '陪陪', class: 'bg-primary' },
                                'talent': { name: '陪陪', class: 'bg-primary' }
                            };
                            const roleObj = roleMap[s.role] || { name: '在職員工', class: 'bg-primary' };

                            const statusMap = {
                                'idle': { name: '空閒中', class: 'status-idle', icon: 'fa-circle-check' },
                                'busy': { name: '接單中', class: 'status-busy', icon: 'fa-gamepad' },
                                'leave': { name: '請假中', class: 'status-leave', icon: 'fa-mug-hot' }
                            };
                            const statusObj = statusMap[s.status] || { name: '空閒中', class: 'status-idle', icon: 'fa-circle-check' };

                            const staffDataJson = JSON.stringify({
                                id: s.id,
                                displayName: displayName,
                                username: s.username,
                                avatar: avUrl,
                                role: s.role,
                                roleName: roleObj.name,
                                status: s.status || 'idle',
                                statusName: statusObj.name,
                                commissionRate: s.commission_rate !== undefined ? s.commission_rate : 0.7,
                                staffChannelId: s.staff_channel_id || '',
                                totalOrders: s.total_orders || 0,
                                totalRevenue: s.total_revenue || 0,
                                realName: s.real_name || '未填寫',
                                birthday: s.birthday || '未填寫',
                                gender: s.gender || '未設定',
                                mbti: s.mbti || '未設定',
                                bankName: s.bank_name || '未填寫',
                                bankCode: s.bank_code || '未填寫',
                                bankBranch: s.bank_branch || '未填寫',
                                bankAccount: s.bank_account || '未填寫',
                                createdAt: s.created_at || '無紀錄'
                            });
                        %>
                            <tr class="staff-row" 
                                data-staff='<%- staffDataJson %>'
                                data-search="<%= `${displayName} ${s.username} ${s.id} ${s.real_name || ''}`.toLowerCase() %>">
                                
                                <td>
                                    <div class="staff-info-col">
                                        <img src="<%= avUrl %>" alt="頭像" class="staff-avatar">
                                        <div>
                                            <div class="fw-bold text-white fs-6"><%= displayName %></div>
                                            <span class="dc-tag-badge">@<%= s.username %></span>
                                        </div>
                                    </div>
                                </td>

                                <td class="text-center">
                                    <span class="badge <%= roleObj.class %> role-badge-tag"><%= roleObj.name %></span>
                                </td>

                                <td class="text-center">
                                    <span class="status-pill <%= statusObj.class %>">
                                        <i class="fa-solid <%= statusObj.icon %>"></i>
                                        <span><%= statusObj.name %></span>
                                    </span>
                                </td>

                                <td>
                                    <span class="rate-pill"><%= ((s.commission_rate !== undefined ? s.commission_rate : 0.7) * 100).toFixed(0) %>%</span>
                                    <span class="small text-secondary ms-1">分潤</span>
                                </td>

                                <td>
                                    <div class="fw-bold text-white font-monospace"><%= Number(s.total_orders || 0) %> 單</div>
                                    <div class="small text-warning font-monospace">$<%= Number(s.total_revenue || 0).toLocaleString() %> NTD</div>
                                </td>

                                <td>
                                    <% if (s.staff_channel_id) { %>
                                        <span class="channel-code-badge"><i class="fa-solid fa-hashtag text-info me-1"></i><%= s.staff_channel_id %></span>
                                    <% } else { %>
                                        <span class="text-secondary small">未綁定頻道</span>
                                    <% } %>
                                </td>

                                <td class="text-end" onclick="event.stopPropagation();">
                                    <div class="action-btns-group justify-content-end">
                                        <button type="button" class="btn btn-sm btn-outline-light rounded-pill px-3 py-1 btn-detail-trigger" style="font-size: 0.8rem;">
                                            <i class="fa-solid fa-address-card me-1"></i>檔案
                                        </button>

                                        <button type="button" class="btn btn-sm btn-outline-success btn-circle-icon btn-edit-trigger" title="設定職位、抽佣與頻道">
                                            <i class="fa-solid fa-user-gear"></i>
                                        </button>

                                        <a href="/management/staff/sync/<%= s.id %>" class="btn btn-sm btn-outline-info btn-circle-icon" title="從 Discord 刷新資料">
                                            <i class="fa-solid fa-rotate"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>

                <div id="noMatchRow" class="text-center py-5 text-secondary" style="display: none;">
                    <i class="fa-solid fa-user-slash fs-3 mb-2 opacity-50"></i>
                    <p class="small mb-0">找不到符合搜尋條件的員工</p>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- 彈窗 1：員工詳細檔案彈窗 -->
<div class="modal fade" id="staffDetailModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 520px;">
        <div class="modal-content modal-content-glass">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold text-white d-flex align-items-center gap-2">
                    <i class="fa-solid fa-id-card-clip text-success"></i>
                    <span>員工完整個人與薪資檔案</span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body py-3">
                <div class="d-flex align-items-center gap-3 p-3 rounded-3 mb-3" style="background: rgba(0, 0, 0, 0.4); border: 1px solid rgba(255, 255, 255, 0.08);">
                    <img id="detailAvatar" src="" class="staff-avatar" style="width: 54px; height: 54px;">
                    <div>
                        <div class="d-flex align-items-center gap-2">
                            <span class="fw-bold fs-5 text-white" id="detailDisplayName"></span>
                            <span id="detailRoleBadge" class="badge bg-primary" style="font-size: 0.72rem;">職位</span>
                            <span id="detailStatusBadge" class="status-pill status-idle" style="font-size: 0.7rem;">狀態</span>
                        </div>
                        <div class="small text-secondary font-monospace" id="detailUsername"></div>
                        <div class="small text-white-50 font-monospace" id="detailId"></div>
                    </div>
                </div>

                <div class="row g-2 mb-3">
                    <div class="col-4">
                        <div class="info-detail-box">
                            <span class="info-detail-label">分潤成數</span>
                            <span class="info-detail-val text-warning" id="detailRate">70%</span>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="info-detail-box">
                            <span class="info-detail-label">完成單數</span>
                            <span class="info-detail-val text-white" id="detailOrders">0 單</span>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="info-detail-box">
                            <span class="info-detail-label">累積總業績</span>
                            <span class="info-detail-val text-success" id="detailRevenue">$0</span>
                        </div>
                    </div>
                </div>

                <div class="p-3 rounded-3 mb-3" style="background: rgba(255, 255, 255, 0.02); border: 1px solid rgba(255, 255, 255, 0.06);">
                    <div class="row g-2 small">
                        <div class="col-6">
                            <span class="text-secondary">生日：</span>
                            <span class="text-white font-monospace fw-bold" id="detailBirthday">未填寫</span>
                        </div>
                        <div class="col-6">
                            <span class="text-secondary">性別：</span>
                            <span class="text-white fw-bold" id="detailGender">未設定</span>
                        </div>
                        <div class="col-6">
                            <span class="text-secondary">MBTI 人格：</span>
                            <span class="text-info font-monospace fw-bold" id="detailMbti">未設定</span>
                        </div>
                        <div class="col-6">
                            <span class="text-secondary">專屬工單頻道：</span>
                            <span class="text-white-50 font-monospace" id="detailChannel">未綁定</span>
                        </div>
                    </div>
                </div>

                <div class="p-3 rounded-3" style="background: rgba(239, 68, 68, 0.06); border: 1px solid rgba(239, 68, 68, 0.25);">
                    <div class="d-flex justify-content-between align-items-center mb-2 pb-1 border-bottom border-danger border-opacity-25">
                        <span class="text-danger small fw-bold"><i class="fa-solid fa-lock me-1"></i>敏感薪轉個資 (限最高管理層)</span>
                        <span class="badge bg-danger bg-opacity-25 text-danger" style="font-size: 0.68rem;">機密</span>
                    </div>
                    <div class="row g-2 small">
                        <div class="col-6">
                            <span class="text-secondary">本名：</span>
                            <span class="text-white fw-bold" id="detailRealName">未填寫</span>
                        </div>
                        <div class="col-6">
                            <span class="text-secondary">銀行名稱：</span>
                            <span class="text-white fw-bold" id="detailBankName">未填寫</span>
                        </div>
                        <div class="col-6">
                            <span class="text-secondary">機構代碼：</span>
                            <span class="text-white font-monospace" id="detailBankCode">未填寫</span>
                        </div>
                        <div class="col-6">
                            <span class="text-secondary">分行名稱：</span>
                            <span class="text-white" id="detailBankBranch">未填寫</span>
                        </div>
                        <div class="col-12 mt-2">
                            <span class="text-secondary">薪轉帳戶：</span>
                            <span class="text-warning font-monospace fw-bold fs-6" id="detailBankAccount">未填寫</span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-sm btn-secondary rounded-pill px-4" data-bs-dismiss="modal">關閉</button>
            </div>
        </div>
    </div>
</div>

<!-- 彈窗 2：編輯員工職位、狀態與抽佣彈窗 -->
<div class="modal fade" id="staffEditModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 460px;">
        <div class="modal-content modal-content-glass">
            <form id="staffEditForm" method="POST">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold text-white d-flex align-items-center gap-2">
                        <i class="fa-solid fa-user-gear text-success"></i>
                        <span>設定員工職務與抽佣</span>
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body py-3">
                    <div class="text-secondary small mb-3">
                        目標員工：<span class="text-white fw-bold" id="editTargetName"></span>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="small text-secondary fw-semibold mb-1">指派身分職位</label>
                            <select id="editRole" name="role" class="form-select form-control-glass" style="background-color: #171326; color: #fff;">
                                <option value="manager">店長</option>
                                <option value="cfo">財務長</option>
                                <option value="after_sales">售後管理</option>
                                <option value="cs_director">客服主管</option>
                                <option value="cs">客服</option>
                                <option value="staff">陪陪 (陪玩師)</option>
                                <option value="admin">負責人</option>
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="small text-secondary fw-semibold mb-1">在職服務狀態</label>
                            <select id="editStatus" name="status" class="form-select form-control-glass" style="background-color: #171326; color: #fff;">
                                <option value="idle">空閒中</option>
                                <option value="busy">接單中</option>
                                <option value="leave">請假中</option>
                            </select>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="small text-secondary fw-semibold mb-1">分潤成數 (小數例如 0.7 代表 70%)</label>
                        <input type="number" step="0.01" min="0" max="1" id="editRate" name="commission_rate" class="form-control form-control-glass font-monospace text-end" required>
                    </div>

                    <div class="mb-2">
                        <label class="small text-secondary fw-semibold mb-1">Discord 專屬工單文字頻道 ID</label>
                        <input type="text" id="editChannel" name="staff_channel_id" class="form-control form-control-glass font-monospace" placeholder="例如：123456789012345678">
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-sm btn-secondary rounded-pill px-3" data-bs-dismiss="modal">取消</button>
                    <button type="submit" class="btn btn-sm btn-success rounded-pill px-4 fw-semibold">儲存設定</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- 尚未實裝功能提示 Modal -->
<div class="modal fade" id="featureModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 420px;">
        <div class="modal-content modal-content-glass text-center p-4">
            <div class="modal-body p-2">
                <img src="/images/logo2.png" alt="米米" class="mascot-modal-img" onerror="this.src='/images/logo.png'">
                <h5 class="fw-bold text-white mb-2" id="modalFeatureTitle">功能開發中</h5>
                <p class="text-secondary small mb-4" id="modalFeatureDesc">米米正在為此功能進行最後調試與模組整合，敬請期待！</p>
                <button type="button" class="btn btn-sm px-4 py-2 rounded-pill text-white fw-semibold" data-bs-dismiss="modal" style="background: linear-gradient(135deg, #9333ea, #7e22ce); border: none;">
                    我知道了
                </button>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
    const staffDetailModal = new bootstrap.Modal(document.getElementById('staffDetailModal'));
    const staffEditModal = new bootstrap.Modal(document.getElementById('staffEditModal'));

    function showStaffDetail(data) {
        document.getElementById('detailAvatar').src = data.avatar;
        document.getElementById('detailDisplayName').textContent = data.displayName;
        document.getElementById('detailRoleBadge').textContent = data.roleName;
        document.getElementById('detailStatusBadge').textContent = data.statusName;
        document.getElementById('detailUsername').textContent = `@${data.username}`;
        document.getElementById('detailId').textContent = `ID: ${data.id}`;
        document.getElementById('detailRate').textContent = `${(Number(data.commissionRate) * 100).toFixed(0)}%`;
        document.getElementById('detailOrders').textContent = `${data.totalOrders} 單`;
        document.getElementById('detailRevenue').textContent = `$${Number(data.totalRevenue).toLocaleString()}`;
        document.getElementById('detailBirthday').textContent = data.birthday;
        document.getElementById('detailGender').textContent = data.gender;
        document.getElementById('detailMbti').textContent = data.mbti;
        document.getElementById('detailChannel').textContent = data.staffChannelId || '未綁定';
        document.getElementById('detailRealName').textContent = data.realName;
        document.getElementById('detailBankName').textContent = data.bankName;
        document.getElementById('detailBankCode').textContent = data.bankCode;
        document.getElementById('detailBankBranch').textContent = data.bankBranch;
        document.getElementById('detailBankAccount').textContent = data.bankAccount;

        staffDetailModal.show();
    }

    function showStaffEdit(data) {
        document.getElementById('staffEditForm').action = `/management/staff/update/${data.id}`;
        document.getElementById('editTargetName').textContent = data.displayName;
        document.getElementById('editRole').value = data.role;
        document.getElementById('editStatus').value = data.status;
        document.getElementById('editRate').value = data.commissionRate;
        document.getElementById('editChannel').value = data.staffChannelId;

        staffEditModal.show();
    }

    document.addEventListener('DOMContentLoaded', () => {
        const rows = document.querySelectorAll('.staff-row');
        const searchInput = document.getElementById('staffSearchInput');
        const clearBtn = document.getElementById('clearSearchBtn');
        const noMatchRow = document.getElementById('noMatchRow');

        searchInput.addEventListener('input', () => {
            const query = searchInput.value.trim().toLowerCase();
            let visibleCount = 0;

            if (query.length > 0) {
                clearBtn.style.display = 'block';
            } else {
                clearBtn.style.display = 'none';
            }

            rows.forEach(row => {
                const searchData = row.getAttribute('data-search') || '';
                if (searchData.includes(query)) {
                    row.style.display = '';
                    visibleCount++;
                } else {
                    row.style.display = 'none';
                }
            });

            noMatchRow.style.display = visibleCount === 0 ? 'block' : 'none';
        });

        clearBtn.addEventListener('click', () => {
            searchInput.value = '';
            clearBtn.style.display = 'none';
            rows.forEach(row => row.style.display = '');
            noMatchRow.style.display = 'none';
            searchInput.focus();
        });

        rows.forEach(row => {
            const data = JSON.parse(row.getAttribute('data-staff'));

            row.addEventListener('click', () => {
                showStaffDetail(data);
            });

            const detailBtn = row.querySelector('.btn-detail-trigger');
            if (detailBtn) {
                detailBtn.addEventListener('click', (e) => {
                    e.stopPropagation();
                    showStaffDetail(data);
                });
            }

            const editBtn = row.querySelector('.btn-edit-trigger');
            if (editBtn) {
                editBtn.addEventListener('click', (e) => {
                    e.stopPropagation();
                    showStaffEdit(data);
                });
            }
        });

        // 綁定側邊欄尚未實裝功能彈窗
        const featureModalEl = document.getElementById('featureModal');
        const featureModal = new bootstrap.Modal(featureModalEl);
        const titleEl = document.getElementById('modalFeatureTitle');
        const descEl = document.getElementById('modalFeatureDesc');

        document.querySelectorAll('.under-construction').forEach(item => {
            item.addEventListener('click', (e) => {
                e.preventDefault();
                const featureName = item.getAttribute('data-feature') || '該功能';
                titleEl.textContent = `【${featureName}】即將開放`;
                descEl.textContent = `米米正在為「${featureName}」進行最後調試與模組整合，敬請期待！`;
                featureModal.show();
            });
        });
    });
</script>
<%- include('partials/feature_modal') %>
</body>
</html>