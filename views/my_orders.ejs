<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>我的訂單 · 米胡電競 MiHu Gaming</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        html, body {
            background-color: #0b0914 !important;
            color: #f3f4f6 !important;
            height: 100%;
            margin: 0;
            overflow: hidden;
        }

        .app-layout {
            display: flex;
            width: 100vw;
            height: 100vh;
            overflow: hidden;
        }

        .main-wrapper {
            flex: 1;
            display: flex;
            flex-direction: column;
            height: 100vh;
            overflow: hidden;
            min-width: 0;
        }

        .content-body {
            padding: 24px;
            flex: 1;
            overflow-y: auto;
            display: flex;
            flex-direction: column;
        }

        /* 🚀 獨立訂單表格卡片與 7 單區域滾動 */
        .glass-table-card {
            background: rgba(23, 19, 38, 0.85) !important;
            border: 1px solid rgba(168, 85, 247, 0.2) !important;
            border-radius: 20px;
            overflow: hidden;
            box-shadow: 0 14px 36px rgba(0, 0, 0, 0.45);
        }

        .table-responsive-scroll { 
            margin: 0; 
            max-height: 520px; 
            overflow-y: auto !important; 
            overflow-x: auto;
            scrollbar-width: thin;
        }

        .mihu-table { width: 100%; margin-bottom: 0; color: #f3f4f6 !important; border-collapse: separate; border-spacing: 0; }
        .mihu-table th {
            background: #131021 !important; color: #94a3b8 !important; font-weight: 700; font-size: 0.84rem;
            text-transform: uppercase; padding: 16px 20px; border-bottom: 1px solid rgba(255, 255, 255, 0.08) !important;
            white-space: nowrap; position: sticky; top: 0; z-index: 10;
        }
        .mihu-table td { padding: 15px 20px; vertical-align: middle; border-bottom: 1px solid rgba(255, 255, 255, 0.05) !important; font-size: 0.92rem; white-space: nowrap; color: #f3f4f6 !important; }
        .mihu-table tbody tr.order-row:hover { background: rgba(168, 85, 247, 0.12) !important; cursor: pointer; }

        .filter-tabs { display: flex; gap: 8px; background: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255, 255, 255, 0.08); padding: 4px; border-radius: 14px; }
        .filter-tab-btn { background: transparent; border: none; color: #94a3b8; font-size: 0.84rem; font-weight: 600; padding: 6px 14px; border-radius: 10px; cursor: pointer; }
        .filter-tab-btn.active { background: rgba(168, 85, 247, 0.25); color: #fff; border: 1px solid rgba(168, 85, 247, 0.4); }

        .search-box-wrap { position: relative; width: 280px; }
        .search-input-glass { background-color: rgba(255, 255, 255, 0.05) !important; border: 1px solid rgba(255, 255, 255, 0.14) !important; color: #ffffff !important; border-radius: 30px; padding: 8px 36px; font-size: 0.88rem; width: 100%; }
        .user-mini-col { display: flex; align-items: center; gap: 10px; }
        .user-mini-avatar { width: 34px; height: 34px; border-radius: 50%; object-fit: cover; border: 1px solid rgba(255, 255, 255, 0.15); }
        .category-badge { font-size: 0.78rem; font-weight: 700; padding: 4px 12px; border-radius: 20px; display: inline-flex; }
        .badge-陪玩單 { background: rgba(168, 85, 247, 0.18); border: 1px solid rgba(168, 85, 247, 0.4); color: #d8b4fe; }
        .status-badge { display: inline-flex; align-items: center; gap: 5px; padding: 4px 10px; border-radius: 20px; font-size: 0.76rem; font-weight: 700; }
        .status-badge-completed { background: rgba(16, 185, 129, 0.15); border: 1px solid rgba(16, 185, 129, 0.4); color: #34d399; }
    </style>
</head>
<body>

<div class="app-layout">
    <%- include('partials/sidebar', { activePage: 'my-orders' }) %>

    <div class="main-wrapper">
        <%- include('partials/navbar', { activePage: 'my-orders' }) %>

        <div class="content-body">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <div class="h4 fw-bold text-white mb-1"><i class="fa-solid fa-receipt text-warning me-2"></i>我的訂單</div>
                    <p class="text-secondary small mb-0">檢視個人所有消費與派單紀錄與陪陪留言心聲</p>
                </div>

                <div class="search-box-wrap">
                    <input type="text" id="orderSearchInput" class="search-input-glass" placeholder="搜尋單號 / 陪陪 / 類別 / 項目...">
                </div>
            </div>

            <div class="d-flex justify-content-between align-items-center mb-3">
                <div class="filter-tabs">
                    <button type="button" class="filter-tab-btn active" data-filter="all">全部紀錄 (<%= orders.length %>)</button>
                    <button type="button" class="filter-tab-btn" data-filter="active">進行中</button>
                    <button type="button" class="filter-tab-btn" data-filter="completed">已完成</button>
                </div>
            </div>

            <div class="glass-table-card">
                <div class="table-responsive-scroll">
                    <table class="mihu-table">
                        <thead>
                            <tr>
                                <th>訂單編號</th>
                                <th>闆闆</th>
                                <th>陪陪</th>
                                <th>類別</th>
                                <th>項目</th>
                                <th>內容</th>
                                <th>數量 / 時長</th>
                                <th>金額</th>
                                <th class="text-center">狀態</th>
                                <th class="text-end">操作</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (!orders || orders.length === 0) { %>
                                <tr><td colspan="10" class="text-center py-5 text-secondary">目前尚無相關訂單紀錄</td></tr>
                            <% } else { %>
                                <% orders.forEach(o => { 
                                    const bossAvatar = o.boss_avatar ? `https://cdn.discordapp.com/avatars/${o.boss_id}/${o.boss_avatar}.png` : `https://cdn.discordapp.com/embed/avatars/0.png`;
                                    const bossName = o.boss_nickname || o.boss_global_name || o.boss_username || '匿名闆闆';
                                    const talentAvatar = o.talent_avatar ? `https://cdn.discordapp.com/avatars/${o.talent_id}/${o.talent_avatar}.png` : `https://cdn.discordapp.com/embed/avatars/1.png`;
                                    const talentName = o.talent_id ? (o.talent_nickname || o.talent_global_name || o.talent_username || '陪玩師') : '派單中';
                                    const totalAmount = Number(o.total_amount || 0);

                                    const orderJson = JSON.stringify({
                                        orderNo: o.order_no, bossName: bossName, talentName: talentName,
                                        category: o.category || '陪玩單', itemName: o.game || '一般服務', contentTier: o.content_tier || '-',
                                        duration: o.duration || 1, unit: o.unit || '小時', totalAmount: totalAmount,
                                        statusName: o.status === 'completed' ? '已完成' : '進行中', extra: o.extra || '無', note: o.note || '無',
                                        talentMessage: o.talent_message || '尚無留言', startTime: o.start_time || '尚未開始', endTime: o.end_time || '尚未結束'
                                    });
                                %>
                                    <tr class="order-row" data-order='<%- orderJson %>'>
                                        <td><div class="fw-bold font-monospace text-light"><%= o.order_no %></div></td>
                                        <td><div class="user-mini-col"><img src="<%= bossAvatar %>" class="user-mini-avatar"><%= bossName %></div></td>
                                        <td><div class="user-mini-col"><img src="<%= talentAvatar %>" class="user-mini-avatar"><%= talentName %></div></td>
                                        <td><span class="category-badge badge-陪玩單"><%= o.category || '陪玩單' %></span></td>
                                        <td><%= o.game || '一般' %></td>
                                        <td><%= o.content_tier || '-' %></td>
                                        <td><%= o.duration %> <%= o.unit || '小時' %></td>
                                        <td><span class="text-warning fw-bold">$<%= totalAmount.toLocaleString() %></span></td>
                                        <td class="text-center"><span class="status-badge status-badge-completed"><%= o.status === 'completed' ? '已完成' : '進行中' %></span></td>
                                        <td class="text-end">
                                            <button class="btn btn-sm btn-outline-light rounded-pill btn-detail-trigger">詳情</button>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include('modals/order_detail_modal') %>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
    const orderDetailModal = new bootstrap.Modal(document.getElementById('orderDetailModal'));
    function showOrderDetail(data) {
        document.getElementById('detailOrderNo').textContent = data.orderNo || '--';
        document.getElementById('detailStatusAndCs').textContent = data.statusName || '進行中';
        document.getElementById('detailBossInfo').textContent = data.bossName || '--';
        document.getElementById('detailTalentInfo').textContent = data.talentName || '派單中';
        document.getElementById('detailCategory').textContent = data.category || '陪玩單';
        document.getElementById('detailItemAndContent').textContent = data.itemName || '--';
        document.getElementById('detailContentTierVal').textContent = data.contentTier || '-';
        document.getElementById('detailDuration').textContent = `${data.duration} ${data.unit}`;
        document.getElementById('detailStartTime').textContent = data.startTime || '尚未開始';
        document.getElementById('detailEndTime').textContent = data.endTime || '尚未結束';
        document.getElementById('detailOriginalPrice').textContent = `$${Number(data.totalAmount).toLocaleString()}`;
        document.getElementById('detailDiscount').textContent = '$0';
        document.getElementById('detailTotalAmount').textContent = `$${Number(data.totalAmount).toLocaleString()} NTD`;
        document.getElementById('detailTalentMessage').textContent = data.talentMessage || '尚無留言';
        document.getElementById('detailExtra').textContent = data.extra || '無特別條件';
        document.getElementById('detailNote').textContent = data.note || '無特別備註';
        orderDetailModal.show();
    }

    document.addEventListener('DOMContentLoaded', () => {
        document.querySelectorAll('.order-row').forEach(row => {
            const data = JSON.parse(row.getAttribute('data-order'));
            row.addEventListener('click', () => showOrderDetail(data));
        });
    });
</script>
</body>
</html>