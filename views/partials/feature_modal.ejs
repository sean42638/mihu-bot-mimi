<!-- 🚀 米胡電競 MiHu Gaming · 獨立未實裝功能通知彈窗組件 partials/feature_modal.ejs -->
<style>
    /* 獨立彈窗專屬 CSS */
    .mascot-feature-modal-content {
        background: rgba(20, 16, 35, 0.97) !important;
        border: 1px solid rgba(168, 85, 247, 0.35) !important;
        border-radius: 20px !important;
        box-shadow: 0 25px 60px rgba(0, 0, 0, 0.8), 0 0 30px rgba(168, 85, 247, 0.25) !important;
        backdrop-filter: blur(25px);
        color: #ffffff !important;
    }

    .mascot-modal-img {
        width: 150px !important;
        height: auto !important;
        margin-bottom: 16px !important;
        filter: drop-shadow(0 0 20px rgba(168, 85, 247, 0.65));
        animation: mascot-bob-anim 3s ease-in-out infinite;
    }

    @keyframes mascot-bob-anim {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(-6px); }
    }
</style>

<!-- 未實裝功能通用吉祥物 Modal -->
<div class="modal fade" id="featureModal" tabindex="-1" aria-hidden="true" style="z-index: 1060;">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 420px;">
        <div class="modal-content mascot-feature-modal-content text-center p-4">
            <div class="modal-body p-2">
                <img src="/images/logo2.png" alt="米米" class="mascot-modal-img" onerror="this.src='/images/logo.png'">
                <h5 class="fw-bold text-white mb-2" id="modalFeatureTitle">功能開發中</h5>
                <p class="text-secondary small mb-4" id="modalFeatureDesc">米米正在為此功能進行最後調試與模組整合，敬請期待！</p>
                <button type="button" class="btn btn-sm px-4 py-2 rounded-pill text-white fw-semibold" data-bs-dismiss="modal" style="background: linear-gradient(135deg, #9333ea, #7e22ce); border: none;">
                    我知道了
                </button>
            </div>
        </div>
    </div>
</div>

<!-- 獨立觸發邏輯腳本 (自動監聽全頁面 .under-construction 元素) -->
<script>
    document.addEventListener('DOMContentLoaded', () => {
        const featureModalEl = document.getElementById('featureModal');
        if (!featureModalEl) return;

        let featureModalInstance = null;

        // 全局自動監聽帶有 .under-construction 的按鈕或連結
        document.addEventListener('click', (e) => {
            const target = e.target.closest('.under-construction');
            if (target) {
                e.preventDefault();
                e.stopPropagation();

                const featureName = target.getAttribute('data-feature') || '該功能';
                const titleEl = document.getElementById('modalFeatureTitle');
                const descEl = document.getElementById('modalFeatureDesc');

                if (titleEl) titleEl.textContent = `【${featureName}】即將開放`;
                if (descEl) descEl.textContent = `米米正在為「${featureName}」進行最後調試與模組整合，敬請期待！`;

                if (!featureModalInstance && typeof bootstrap !== 'undefined') {
                    featureModalInstance = new bootstrap.Modal(featureModalEl);
                }

                if (featureModalInstance) {
                    featureModalInstance.show();
                }
            }
        });
    });
</script>