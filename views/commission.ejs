<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>抽佣設定 · 米胡電競 MiHu Gaming</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --bg-color: #0b0914;
            --sidebar-bg: #131021;
            --card-bg: rgba(23, 19, 38, 0.85);
            --card-border: rgba(168, 85, 247, 0.2);
            --mihu-purple-light: #c084fc;
            --text-light: #f3f4f6;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            background-color: var(--bg-color);
            color: var(--text-light);
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            display: flex;
            min-height: 100vh;
        }

        .main-wrapper {
            flex-grow: 1;
            display: flex;
            flex-direction: column;
            overflow-y: auto;
            max-height: 100vh;
        }

        .content-body { padding: 20px 36px 32px; flex-grow: 1; }

        .glass-card {
            background: var(--card-bg);
            border: 1px solid var(--card-border);
            border-radius: 20px;
            padding: 28px;
            box-shadow: 0 14px 36px rgba(0, 0, 0, 0.45);
            backdrop-filter: blur(15px);
        }

        .category-item-box {
            background: rgba(0, 0, 0, 0.35);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 14px;
            padding: 16px 20px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            transition: all 0.2s ease;
        }
        .category-item-box:hover {
            border-color: rgba(168, 85, 247, 0.35);
            background: rgba(168, 85, 247, 0.05);
        }

        .category-badge {
            font-size: 0.85rem;
            font-weight: 700;
            padding: 5px 14px;
            border-radius: 20px;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }
        .badge-陪玩單 { background: rgba(168, 85, 247, 0.18); border: 1px solid rgba(168, 85, 247, 0.4); color: #d8b4fe; }
        .badge-禮物單 { background: rgba(236, 72, 153, 0.18); border: 1px solid rgba(236, 72, 153, 0.4); color: #f472b6; }
        .badge-有獎單 { background: rgba(56, 189, 248, 0.18); border: 1px solid rgba(56, 189, 248, 0.4); color: #7dd3fc; }
        .badge-冠名單 { background: rgba(245, 158, 11, 0.18); border: 1px solid rgba(245, 158, 11, 0.4); color: #fde047; }
        .badge-獎金   { background: rgba(16, 185, 129, 0.18); border: 1px solid rgba(16, 185, 129, 0.4); color: #6ee7b7; }

        .form-control-glass {
            background-color: rgba(255, 255, 255, 0.05) !important;
            border: 1px solid rgba(255, 255, 255, 0.18) !important;
            color: #ffffff !important;
            border-radius: 12px;
            padding: 8px 14px;
            font-size: 0.95rem;
            font-weight: 700;
            font-family: monospace;
            width: 120px;
            text-align: right;
        }
        .form-control-glass:focus {
            background-color: #171326 !important;
            border-color: #c084fc !important;
            box-shadow: 0 0 0 3px rgba(168, 85, 247, 0.3) !important;
            outline: none !important;
        }
    </style>
</head>
<body>

<%- include('partials/sidebar', { activePage: 'commission' }) %>

<div class="main-wrapper">
    <%- include('partials/navbar', { activePage: 'commission' }) %>

    <div class="content-body">
        <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
            <div>
                <div class="page-title-text" style="font-size: 1.5rem; font-weight: 800; color: #ffffff; display: flex; align-items: center; gap: 10px; margin-bottom: 4px;">
                    <i class="fa-solid fa-percent text-warning"></i>
                    <span>米胡電競分潤設定</span>
                </div>
                <p class="text-secondary small mb-0">設定米胡電競各訂單類別與服務項目的陪玩實得成數</p>
            </div>
        </div>

        <% if (typeof success !== 'undefined' && success) { %>
            <div class="alert alert-success py-2 px-3 small mb-4 border-0 bg-success bg-opacity-25 text-success">
                ✅ 工作室分潤設定已更新！
            </div>
        <% } %>
        <% if (typeof error !== 'undefined' && error) { %>
            <div class="alert alert-danger py-2 px-3 small mb-4 border-0 bg-danger bg-opacity-25 text-danger"><%= error %></div>
        <% } %>

        <div class="glass-card mb-4" style="max-width: 900px;">
            <form action="/system/commission/update" method="POST">
                <input type="hidden" name="studio_id" value="<%= selectedStudioId %>">
                <div class="alert alert-info py-2 px-3 small mb-4 bg-info bg-opacity-10 border-info border-opacity-25 text-info d-flex align-items-center gap-2">
                    <i class="fa-solid fa-circle-info fs-6"></i>
                    <span><strong>比例單位：</strong> 填寫 0 到 1 的陪玩實拿比例，例如 <code>0.7</code> 為 70%；個別服務設定優先於陪玩個人特例，再回退至此類別預設。</span>
                </div>

                <h6 class="text-white fw-bold mb-3">工作室類別預設</h6>
                <div class="d-flex flex-column gap-3 mb-4">
                    <% const categories = ["陪玩單", "禮物單", "有獎單", "冠名單", "獎金"]; %>
                    <% categories.forEach(cat => { 
                        const currentRate = commission[cat] !== undefined ? Number(commission[cat]) : 0.8;
                    %>
                        <div class="category-item-box">
                            <div class="d-flex align-items-center gap-3">
                                <span class="category-badge badge-<%= cat %>"><%= cat %></span>
                                <span class="small text-secondary">類別 fallback</span>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <input type="number" step="0.01" min="0" max="1" name="rates[<%= cat %>]" value="<%= currentRate %>" class="form-control form-control-glass" required>
                                <span class="fw-bold text-warning font-monospace" style="width: 45px;"><%= (currentRate * 100).toFixed(0) %>%</span>
                            </div>
                        </div>
                    <% }) %>
                </div>

                <h6 class="text-white fw-bold mb-3">服務項目成數</h6>
                <% if (!services || services.length === 0) { %>
                    <p class="small text-secondary">尚無服務項目；新增服務後即可設定個別成數。</p>
                <% } else { %>
                    <div class="table-responsive mb-4">
                        <table class="table table-dark table-sm align-middle mb-0">
                            <thead><tr><th>服務項目</th><th>類別</th><th class="text-end">陪玩實拿比例</th></tr></thead>
                            <tbody>
                                <% services.forEach(service => { %>
                                    <tr>
                                        <td><%= service.name %></td>
                                        <td><%= service.category %></td>
                                        <td class="text-end">
                                            <input type="number" step="0.01" min="0" max="1" name="service_rate_<%= service.id %>" value="<%= service.talent_share_rate === null ? '' : service.talent_share_rate %>" placeholder="沿用類別" class="form-control form-control-glass ms-auto">
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                <% } %>

                <div class="d-flex justify-content-end">
                    <button type="submit" class="btn btn-warning rounded-pill px-4 fw-bold text-dark" style="background: linear-gradient(135deg, #fde047, #eab308); border: none;">
                        <i class="fa-solid fa-floppy-disk me-1.5"></i>儲存分潤設定
                    </button>
                </div>
            </form>
        </div>

        <div class="glass-card mb-4" style="max-width: 900px;">
            <h6 class="text-white fw-bold mb-3">新增服務項目</h6>
            <form action="/system/commission/services" method="POST" class="row g-3 align-items-end">
                <input type="hidden" name="studio_id" value="<%= selectedStudioId %>">
                <div class="col-md-5">
                    <label class="form-label small text-secondary">服務名稱</label>
                    <input type="text" name="name" maxlength="100" class="form-control form-control-glass w-100 text-start" required>
                </div>
                <div class="col-md-3">
                    <label class="form-label small text-secondary">類別</label>
                    <select name="category" class="form-select">
                        <% ["陪玩單", "禮物單", "有獎單", "冠名單", "獎金"].forEach(cat => { %>
                            <option value="<%= cat %>"><%= cat %></option>
                        <% }) %>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label small text-secondary">實拿比例</label>
                    <input type="number" name="talent_share_rate" min="0" max="1" step="0.01" placeholder="類別預設" class="form-control form-control-glass w-100">
                </div>
                <div class="col-md-2 d-grid">
                    <button type="submit" class="btn btn-outline-info"><i class="fa-solid fa-plus me-1"></i>新增</button>
                </div>
            </form>
        </div>

    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<%- include('partials/feature_modal') %>
</body>
</html>