<!-- 🚀 我的錢包詳細 / 儲值說明 Modal -->
<div class="modal fade" id="walletDetailModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content" style="background: rgba(19, 16, 33, 0.95); border: 1px solid rgba(168, 85, 247, 0.3); border-radius: 24px; backdrop-filter: blur(20px); color: #f3f4f6; box-shadow: 0 20px 50px rgba(0,0,0,0.6);">
            
            <div class="modal-header border-bottom border-secondary border-opacity-25 px-4 py-3">
                <h5 class="modal-title fw-bold text-white d-flex align-items-center gap-2">
                    <i class="fa-solid fa-wallet text-warning"></i>
                    <span>會員錢包資產詳情</span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body p-4">
                <!-- 👑 用戶個人簡介區 -->
                <div class="d-flex align-items-center gap-3 p-3 mb-4" style="background: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 16px;">
                    <img id="walletModalAvatar" src="https://cdn.discordapp.com/embed/avatars/0.png" class="rounded-circle" style="width: 50px; height: 50px; object-fit: cover; border: 2px solid rgba(168, 85, 247, 0.5);">
                    <div>
                        <div class="fw-bold fs-6 text-white" id="walletModalUserName">闆闆帳號</div>
                        <div class="small text-secondary font-monospace" id="walletModalUserId">ID: --</div>
                    </div>
                </div>

                <!-- 💰 核心餘額三統計 -->
                <div class="row g-3 mb-4">
                    <div class="col-md-4">
                        <div class="p-3 text-center" style="background: linear-gradient(135deg, rgba(168, 85, 247, 0.15), rgba(88, 28, 135, 0.25)); border: 1px solid rgba(168, 85, 247, 0.4); border-radius: 16px;">
                            <div class="small text-secondary mb-1"><i class="fa-solid fa-coins text-warning me-1"></i>當前總可用餘額</div>
                            <div class="fs-4 fw-bold font-monospace text-warning" id="walletModalBalance">$0</div>
                            <span class="small text-secondary">NTD</span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-3 text-center" style="background: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 16px;">
                            <div class="small text-secondary mb-1"><i class="fa-solid fa-money-bill-wave text-info me-1"></i>總累積實充</div>
                            <div class="fs-4 fw-bold font-monospace text-info" id="walletModalRealBalance">$0</div>
                            <span class="small text-secondary">NTD</span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-3 text-center" style="background: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 16px;">
                            <div class="small text-secondary mb-1"><i class="fa-solid fa-gift text-success me-1"></i>贈送餘額</div>
                            <div class="fs-4 fw-bold font-monospace text-success" id="walletModalBonusBalance">$0</div>
                            <span class="small text-secondary">NTD</span>
                        </div>
                    </div>
                </div>

                <!-- 📌 儲值說明卡片 -->
                <div class="p-3" style="background: rgba(245, 158, 11, 0.08); border: 1px solid rgba(245, 158, 11, 0.25); border-radius: 16px;">
                    <div class="fw-bold text-warning small mb-1"><i class="fa-solid fa-circle-info me-1"></i>儲值與流水說明</div>
                    <div class="small text-secondary" style="font-size: 0.82rem; line-height: 1.6;">
                        如需進行線上儲值，請透過 Discord 社群聯繫「米胡客服」處理。系統於完成點單扣款或點數異動時，會自動產生帳戶流水紀錄與消費連動紀錄。
                    </div>
                </div>
            </div>

            <div class="modal-footer border-top border-secondary border-opacity-25 px-4 py-3">
                <button type="button" class="btn btn-outline-secondary px-4 py-2 rounded-pill small" data-bs-dismiss="modal">關閉</button>
            </div>
        </div>
    </div>
</div>