<!-- 彈窗 1：會員詳細內容彈窗 -->
<div class="modal fade" id="memberDetailModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 500px;">
        <div class="modal-content modal-content-glass">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold text-white d-flex align-items-center gap-2">
                    <i class="fa-solid fa-address-card text-info"></i>
                    <span>會員詳細檔案內容</span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body py-3">
                <div class="d-flex align-items-center gap-3 p-3 rounded-3 mb-3" style="background: rgba(0, 0, 0, 0.4); border: 1px solid rgba(255, 255, 255, 0.08);">
                    <img id="detailAvatar" src="" class="member-avatar" style="width: 52px; height: 52px;">
                    <div>
                        <div class="d-flex align-items-center gap-2">
                            <span class="fw-bold fs-5 text-white" id="detailDisplayName"></span>
                            <span id="detailRoleBadge" class="badge bg-secondary" style="font-size: 0.72rem;">身分</span>
                        </div>
                        <div class="small text-secondary font-monospace" id="detailUsername"></div>
                        <div class="small text-white-50 font-monospace" id="detailId"></div>
                    </div>
                </div>

                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <div class="info-detail-box">
                            <span class="info-detail-label">VIP 等級</span>
                            <span class="info-detail-val text-warning" id="detailVip"></span>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="info-detail-box">
                            <span class="info-detail-label">當前總可用餘額</span>
                            <span class="info-detail-val text-white" id="detailTotalBalance"></span>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="info-detail-box">
                            <span class="info-detail-label">累積消費</span>
                            <span class="info-detail-val text-warning" id="detailSpent"></span>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="info-detail-box">
                            <span class="info-detail-label">累積實充</span>
                            <span class="info-detail-val text-info" id="detailDeposited"></span>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="info-detail-box">
                            <span class="info-detail-label">VIP 升級差距</span>
                            <span class="text-light small font-monospace" id="detailVipGap"></span>
                        </div>
                    </div>
                </div>

                <div class="p-3 rounded-3" style="background: rgba(255, 255, 255, 0.02); border: 1px solid rgba(255, 255, 255, 0.06);">
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-secondary small">會員生日</span>
                        <span class="text-white small font-monospace fw-bold" id="detailBirthday">未填寫</span>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span class="text-secondary small">創建與註冊時間</span>
                        <span class="text-white-50 small font-monospace" id="detailCreatedAt"></span>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-sm btn-secondary rounded-pill px-4" data-bs-dismiss="modal">關閉</button>
            </div>
        </div>
    </div>
</div>

<!-- 彈窗 2：會員帳務調整 Modal -->
<div class="modal fade" id="adjustBalanceModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 480px;">
        <div class="modal-content modal-content-glass">
            <form id="adjustBalanceForm" method="POST">
                <input type="hidden" name="current_balance" id="hiddenCurrentBalance" value="0">
                <input type="hidden" name="current_bonus" id="hiddenCurrentBonus" value="0">

                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold text-white"><i class="fa-solid fa-wallet text-warning me-2"></i>會員帳務調整</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body py-3">
                    <p class="text-secondary small mb-3">目標會員：<strong class="text-white" id="balanceTargetName">--</strong></p>
                    
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="small text-secondary fw-semibold mb-1">本次充值金額 ($)</label>
                            <input type="number" step="any" name="add_amount" id="modalAddAmount" class="form-control form-control-glass" placeholder="例如：1000 或 -500">
                            <div class="text-secondary" style="font-size: 0.72rem; margin-top: 2px;">正數將自動計入累積實充</div>
                        </div>
                        <div class="col-6">
                            <label class="small text-secondary fw-semibold mb-1">贈送金 ($)</label>
                            <input type="number" step="any" name="bonus_change" id="modalBonusBalance" class="form-control form-control-glass" placeholder="例如：100 或 -50">
                            <div class="text-secondary" style="font-size: 0.72rem; margin-top: 2px;">可進行正負加減運算</div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="small text-secondary fw-semibold mb-1">調整目前餘額 ($)</label>
                        <input type="number" step="any" name="balance" id="modalBalance" class="form-control form-control-glass" placeholder="不覆蓋請留空">
                        <div class="text-secondary" style="font-size: 0.72rem; margin-top: 2px;">直接更改會員目前實充餘額</div>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="small text-secondary fw-semibold mb-1">調整累積消費 ($)</label>
                            <input type="number" step="any" name="total_spent" id="modalSpent" class="form-control form-control-glass" placeholder="不覆蓋請留空 (可填 0)">
                            <div class="text-secondary" style="font-size: 0.72rem; margin-top: 2px;">覆蓋總累積消費額</div>
                        </div>
                        <div class="col-6">
                            <label class="small text-secondary fw-semibold mb-1">調整累積實充 ($)</label>
                            <input type="number" step="any" name="total_deposited" id="modalDeposited" class="form-control form-control-glass" placeholder="不覆蓋請留空 (可填 0)">
                            <div class="text-secondary" style="font-size: 0.72rem; margin-top: 2px;">覆蓋總累積充值金額</div>
                        </div>
                    </div>

                    <div class="alert alert-warning py-2 small mb-3 bg-warning bg-opacity-10 border-warning border-opacity-25 text-warning" style="font-size: 0.8rem;">
                        ⚠️ 零負數防護：最終經計算後之數目若小於 0，將觸發鎖定歸零或無法提交。
                    </div>

                    <div class="mb-2">
                        <label class="small text-secondary fw-semibold mb-1">調帳備註原因</label>
                        <input type="text" name="note" class="form-control form-control-glass" placeholder="例：活動儲值贈送或客服退款" required>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-sm btn-secondary rounded-pill px-3" data-bs-dismiss="modal">取消</button>
                    <button type="submit" class="btn btn-sm btn-warning rounded-pill px-4 text-dark fw-bold">確認更新帳務</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- 彈窗 3：獨立 VIP 與身分同步調整 Modal -->
<div class="modal fade" id="vipModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 440px;">
        <div class="modal-content modal-content-glass">
            <form id="vipForm" method="POST">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold text-white d-flex align-items-center gap-2">
                        <i class="fa-solid fa-crown text-warning"></i>
                        <span>手動 VIP 與全後台身分調整</span>
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body py-3">
                    <div class="text-secondary small mb-3">
                        目標會員：<span class="text-white fw-bold" id="vipTargetName">--</span>
                    </div>

                    <div class="mb-3">
                        <label class="small text-secondary fw-semibold mb-1">VIP 等級 (可輸入數字或 +1 / -1)</label>
                        <input type="text" id="inputVipOnly" name="vip_level" class="form-control form-control-glass text-end" placeholder="0 或 +1" required>
                    </div>

                    <div class="mb-3">
                        <label class="small text-secondary fw-semibold mb-1">連動後台身分角色</label>
                        <select id="inputRoleSelect" name="role" class="form-select form-control-glass" style="background-color: #171326; color: #fff;">
                            <option value="member">會員</option>
                            <option value="talent">陪陪</option>
                            <option value="cs">客服</option>
                            <option value="manager">客服主管</option>
                            <option value="aftersales">售後管理</option>
                            <option value="cfo">財務長</option>
                            <option value="admin">店長</option>
                        </select>
                    </div>

                    <div class="mb-2">
                        <label class="small text-secondary fw-semibold mb-1">調整原因 / 操作備註 (選填)</label>
                        <input type="text" name="note" class="form-control form-control-glass" placeholder="例如：手動升級貴賓或權限調整">
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-sm btn-secondary rounded-pill px-3" data-bs-dismiss="modal">取消</button>
                    <button type="submit" class="btn btn-sm btn-warning rounded-pill px-4 fw-semibold text-dark">確認同步更新</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- 🚨 獨立防呆彈窗：數目不得為負數 Modal -->
<div class="modal fade" id="negativeErrorModal" tabindex="-1" aria-hidden="true" style="z-index: 1060;">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content" style="background: #1f1a30; border: 1px solid rgba(239, 68, 68, 0.5); border-radius: 18px; color: #f3f4f6; box-shadow: 0 10px 30px rgba(239, 68, 68, 0.35);">
            <div class="modal-body text-center py-4">
                <div class="text-danger fs-1 mb-2">
                    <i class="fa-solid fa-circle-xmark"></i>
                </div>
                <h6 class="fw-bold text-white mb-2">數目不得為負數</h6>
                <p id="negativeErrorText" class="text-secondary small mb-3">計算後的帳務數目不得小於 0！</p>
                <button type="button" class="btn btn-danger rounded-pill px-4 py-1 small fw-bold" data-bs-dismiss="modal">確定</button>
            </div>
        </div>
    </div>
</div>

<script>
    window.currentMemberBalance = 0;
    window.currentMemberBonus = 0;

    // 🚀 全域提供開啟帳務 Modal 函數 (徹底修復：預設全清空！絕不預填舊累積金額)
    window.openAdjustBalanceModal = function(memberData) {
        if (!memberData) return;

        window.currentMemberBalance = Number(memberData.balance || 0);
        window.currentMemberBonus = Number(memberData.bonus_balance || memberData.bonus || 0);

        const form = document.getElementById('adjustBalanceForm');
        if (form) form.action = `/management/members/update-balance/${memberData.id}`;

        const nameEl = document.getElementById('balanceTargetName');
        if (nameEl) nameEl.textContent = memberData.custom_nickname || memberData.global_name || memberData.username;

        // 寫入隱藏欄位
        document.getElementById('hiddenCurrentBalance').value = window.currentMemberBalance;
        document.getElementById('hiddenCurrentBonus').value = window.currentMemberBonus;

        // 🚀 關鍵修復：完全清空輸入框！
        document.getElementById('modalAddAmount').value = '';
        document.getElementById('modalBonusBalance').value = '';
        document.getElementById('modalBalance').value = ''; 
        document.getElementById('modalSpent').value = '';
        document.getElementById('modalDeposited').value = ''; // 強制為空，不帶入任何舊值

        const modalEl = document.getElementById('adjustBalanceModal');
        if (modalEl) {
            const instance = bootstrap.Modal.getOrCreateInstance(modalEl);
            instance.show();
        }
    };

    // 🚀 前端提交攔截與負數獨立彈窗顯示
    document.addEventListener('DOMContentLoaded', () => {
        const adjustForm = document.getElementById('adjustBalanceForm');
        if (adjustForm) {
            adjustForm.addEventListener('submit', function (e) {
                const currBalance = Number(window.currentMemberBalance || 0);
                const currBonus = Number(window.currentMemberBonus || 0);

                const addAmountVal = document.getElementById('modalAddAmount').value.trim();
                const bonusChangeVal = document.getElementById('modalBonusBalance').value.trim();
                const directBalanceVal = document.getElementById('modalBalance').value.trim();
                const totalSpentVal = document.getElementById('modalSpent').value.trim();
                const totalDepositedVal = document.getElementById('modalDeposited').value.trim();

                let finalBalance = currBalance;
                let finalBonus = currBonus;

                if (directBalanceVal !== '') {
                    finalBalance = Number(directBalanceVal);
                } else if (addAmountVal !== '') {
                    finalBalance = currBalance + Number(addAmountVal);
                }

                if (bonusChangeVal !== '') {
                    finalBonus = currBonus + Number(bonusChangeVal);
                }

                let errorMsg = '';
                if (finalBalance < 0) {
                    errorMsg = `當前實充為 $${currBalance}，扣除後最終餘額為 $${finalBalance}，數目不得為負數！`;
                } else if (finalBonus < 0) {
                    errorMsg = `當前贈送金為 $${currBonus}，扣除後最終贈送金為 $${finalBonus}，數目不得為負數！`;
                } else if (totalSpentVal !== '' && Number(totalSpentVal) < 0) {
                    errorMsg = '「累積消費」不得設定為負數！';
                } else if (totalDepositedVal !== '' && Number(totalDepositedVal) < 0) {
                    errorMsg = '「累積實充」不得設定為負數！';
                }

                if (errorMsg) {
                    e.preventDefault();
                    document.getElementById('negativeErrorText').textContent = errorMsg;
                    const errModalEl = document.getElementById('negativeErrorModal');
                    if (errModalEl) {
                        const errInstance = bootstrap.Modal.getOrCreateInstance(errModalEl);
                        errInstance.show();
                    }
                }
            });
        }
    });
</script>